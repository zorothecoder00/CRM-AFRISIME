{
  "name": "afriflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "build": "prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "check": "npm run lint && tsc --noEmit && next build",
    "db:seed": "prisma db seed",
    "migrate:deploy:neon": "tsx scripts/migrate-deploy-neon.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "sync-role-permissions": "tsx scripts/sync-role-permissions.ts",
    "backfill-platform-organization": "tsx scripts/backfill-platform-organization.ts",
    "setup-local-rls-test-role": "tsx scripts/setup-local-rls-test-role.ts",
    "setup-production-tenant-role": "tsx scripts/setup-production-tenant-role.ts",
    "seed-project-templates": "tsx scripts/seed-project-templates.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
