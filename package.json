    "lucide-react": "^0.562.0",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "otplib": "^12.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "pptxgenjs": "^4.0.1",
