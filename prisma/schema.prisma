  tasks       Task[]       @relation("PlatformOrganizationTasks")
  projectSections ProjectSection[] @relation("PlatformOrganizationProjectSections")
  documents       Document[]       @relation("PlatformOrganizationDocuments")
  meetings        Meeting[]        @relation("PlatformOrganizationMeetings")
  documentFolders DocumentFolder[] @relation("PlatformOrganizationDocumentFolders")
  whiteboards          Whiteboard[]         @relation("PlatformOrganizationWhiteboards")
  projectMembers       ProjectMember[]      @relation("PlatformOrganizationProjectMembers")
  projectRisks         ProjectRisk[]        @relation("PlatformOrganizationProjectRisks")
  projectMilestones    ProjectMilestone[]   @relation("PlatformOrganizationProjectMilestones")
  projectDeliverables  ProjectDeliverable[] @relation("PlatformOrganizationProjectDeliverables")
  projectResources     ProjectResource[]    @relation("PlatformOrganizationProjectResources")
  sectionComments             SectionComment[]             @relation("PlatformOrganizationSectionComments")
  taskAssignees                TaskAssignee[]                @relation("PlatformOrganizationTaskAssignees")
  checklistItems                ChecklistItem[]                @relation("PlatformOrganizationChecklistItems")
  taskComments                  TaskComment[]                  @relation("PlatformOrganizationTaskComments")
  taskDependencies               TaskDependency[]               @relation("PlatformOrganizationTaskDependencies")
  documentAccesses               DocumentAccess[]               @relation("PlatformOrganizationDocumentAccesses")
  documentVersions                DocumentVersion[]              @relation("PlatformOrganizationDocumentVersions")
  meetingParticipants             MeetingParticipant[]           @relation("PlatformOrganizationMeetingParticipants")
  meetingDecisions                 MeetingDecision[]              @relation("PlatformOrganizationMeetingDecisions")
  meetingExternalParticipants       MeetingExternalParticipant[]  @relation("PlatformOrganizationMeetingExternalParticipants")
  competences       Competence[]        @relation("PlatformOrganizationCompetences")
  userCompetences    UserCompetence[]    @relation("PlatformOrganizationUserCompetences")
  knowledgeCategories KnowledgeCategory[] @relation("PlatformOrganizationKnowledgeCategories")
  knowledgeArticles    KnowledgeArticle[]  @relation("PlatformOrganizationKnowledgeArticles")
  leaves                Leave[]             @relation("PlatformOrganizationLeaves")
  events                 Event[]             @relation("PlatformOrganizationEvents")
  objectives              Objective[]         @relation("PlatformOrganizationObjectives")
  indicators               Indicator[]         @relation("PlatformOrganizationIndicators")
  evaluations               Evaluation[]        @relation("PlatformOrganizationEvaluations")
  evaluationCriteres        EvaluationCritere[] @relation("PlatformOrganizationEvaluationCriteres")
  conversations            Conversation[]            @relation("PlatformOrganizationConversations")
  conversationParticipants ConversationParticipant[] @relation("PlatformOrganizationConversationParticipants")
  messages                  Message[]                 @relation("PlatformOrganizationMessages")
  reactions                  Reaction[]                @relation("PlatformOrganizationReactions")
  notifications                Notification[]            @relation("PlatformOrganizationNotifications")
  crmOrganizations       CrmOrganization[]     @relation("PlatformOrganizationCrmOrganizations")
  crmContacts             CrmContact[]          @relation("PlatformOrganizationCrmContacts")
  portalAccounts           PortalAccount[]       @relation("PlatformOrganizationPortalAccounts")
  portalInviteTokens        PortalInviteToken[]   @relation("PlatformOrganizationPortalInviteTokens")
  crmOpportunities            CrmOpportunity[]      @relation("PlatformOrganizationCrmOpportunities")
  crmInteractions               CrmInteraction[]      @relation("PlatformOrganizationCrmInteractions")
  contracts                       Contract[]            @relation("PlatformOrganizationContracts")
  portalMessages                    PortalMessage[]       @relation("PlatformOrganizationPortalMessages")
  decisionOutcomes       DecisionOutcome[]       @relation("PlatformOrganizationDecisionOutcomes")
  postes                   Poste[]                 @relation("PlatformOrganizationPostes")
  posteResponsabilites       PosteResponsabilite[]   @relation("PlatformOrganizationPosteResponsabilites")
  successionPlans               SuccessionPlan[]        @relation("PlatformOrganizationSuccessionPlans")
  successionCandidates             SuccessionCandidate[]   @relation("PlatformOrganizationSuccessionCandidates")
  sites                               Site[]                  @relation("PlatformOrganizationSites")
  delegations                           Delegation[]            @relation("PlatformOrganizationDelegations")
  strategicAxes                           StrategicAxis[]         @relation("PlatformOrganizationStrategicAxes")
  swotItems                                 SwotItem[]              @relation("PlatformOrganizationSwotItems")
  plans                                       Plan[]                  @relation("PlatformOrganizationPlans")
  programmes                                    Programme[]             @relation("PlatformOrganizationProgrammes")
  programmeRisks                                  ProgrammeRisk[]         @relation("PlatformOrganizationProgrammeRisks")
  governanceInstances       GovernanceInstance[]           @relation("PlatformOrganizationGovernanceInstances")
  governanceInstanceMembers   GovernanceInstanceMember[]     @relation("PlatformOrganizationGovernanceInstanceMembers")
  governanceMeetings            GovernanceMeeting[]            @relation("PlatformOrganizationGovernanceMeetings")
  governanceMeetingParticipants   GovernanceMeetingParticipant[] @relation("PlatformOrganizationGovernanceMeetingParticipants")
  governanceMeetingDocuments        GovernanceMeetingDocument[]    @relation("PlatformOrganizationGovernanceMeetingDocuments")
  governanceDecisions                  GovernanceDecision[]           @relation("PlatformOrganizationGovernanceDecisions")
  processusListe                          Processus[]                     @relation("PlatformOrganizationProcessus")
  processusEtapes                             ProcessusEtape[]                @relation("PlatformOrganizationProcessusEtapes")
  processusVersions                               ProcessusVersion[]              @relation("PlatformOrganizationProcessusVersions")
  processusExecutions                                 ProcessusExecution[]            @relation("PlatformOrganizationProcessusExecutions")
