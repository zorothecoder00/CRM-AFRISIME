// AfriFlow (AfriSime Work-Flow) — schéma
// Domaines couverts : Auth/Rôles/Permissions (+ dérogations scopées
// département/projet via PermissionOverride), Départements, Projets
// (hiérarchie Phase/Sous-phase/Lot, chaque niveau avec responsable/
// documents/commentaires), Tâches (+ sous-tâches, checklist, commentaires,
// dépendances, circuit de validation multi-étapes configurable via
// ValidationWorkflow), Réunions (ordre du jour, participants, compte rendu,
// décisions → tâches auto-créées), Documents (dossiers, versions, liaison
// tâche/réunion/section), Calendrier (congés, événements), Objectifs & KPI
// (individuel/équipe/département, indicateurs mesurables), Charge de travail
// (calculée depuis Task/Leave, pas de modèle dédié), Messagerie
// (conversations, réactions, mentions, pièces jointes), Notifications
// (in-app ; email/push hors périmètre — nécessitent des services externes
// non configurés), Automatisations (règles projet déclencheur → action,
// sans développement), Tableaux de bord (widgets configurables), Audit.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleKey {
  SUPER_ADMIN
  DIRECTEUR_GENERAL
  DIRECTEUR
  CHEF_DEPARTEMENT
  CHEF_PROJET
  RESPONSABLE
  MANAGER
  COLLABORATEUR
  CONSULTANT_EXTERNE
  PRESTATAIRE
  INVITE
}

enum ProjectStatus {
  PLANIFIE
  EN_COURS
  EN_PAUSE
  TERMINE
  ANNULE
}

enum ProjectPriority {
  BASSE
  MOYENNE
  HAUTE
  CRITIQUE
}

enum SectionType {
  PHASE
  SOUS_PHASE
  LOT
}

enum SectionStatus {
  A_VENIR
  EN_COURS
  TERMINE
  EN_RETARD
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  EN_REVISION
  BLOQUEE
  TERMINEE
  ANNULEE
}

enum TaskPriority {
  TRES_HAUTE
  HAUTE
  MOYENNE
  BASSE
}

enum DependencyType {
  BLOQUE
  LIE_A
}

enum ProjectMemberRole {
  CHEF_PROJET
  MEMBRE
  OBSERVATEUR
}

enum MeetingStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum LeaveType {
  CONGE_PAYE
  MALADIE
  AUTRE
}

enum LeaveStatus {
  EN_ATTENTE
  APPROUVE
  REFUSE
}

enum ObjectivePeriod {
  ANNUEL
  TRIMESTRIEL
  MENSUEL
  HEBDOMADAIRE
}

// « équipe » n'a pas de modèle dédié dans ce MVP — une équipe est
// représentée par les membres d'un Projet (ProjectMember), déjà modélisé.
enum ObjectiveScope {
  ORGANISATION
  INDIVIDUEL
  EQUIPE
  DEPARTEMENT
  PROGRAMME
}

enum ObjectiveStatus {
  EN_COURS
  ATTEINT
  NON_ATTEINT
  ANNULE
}

// Cahier des charges §18. VALIDATION couvre a la fois la decision de conge
// et chaque etape d'un circuit de validation de tache (§9) ; SURCHARGE est
// emise par le cron de charge de travail (§14).
enum NotificationType {
  NOUVELLE_TACHE
  MODIFICATION
  COMMENTAIRE
  VALIDATION
  ECHEANCE_PROCHE
  RETARD
  MENTION
  SURCHARGE
  CLIENT_SANS_SUIVI
  BUDGET_DEPASSE
  RELANCE_PLANIFIEE
  TACHE_CRITIQUE
}

// Cahier des charges §9 — circuit de validation configurable : une chaine
// ordonnee d'etapes, chacune assignee a un role approbateur. `ValidationRun`
// est l'instance en cours (ou terminee) pour une tache precise ; `Approval`
// est la decision prise a une etape donnee de cette instance.
enum ValidationEntityType {
  TASK
  ADMIN_REQUEST
}

// Demandes administratives generiques (cahier des charges §VII/§VIII) : tout
// sauf les conges, qui restent geres par le modele Leave dedie existant.
enum AdminRequestType {
  ACHAT
  MISSION
  DECAISSEMENT
  MATERIEL
  AUTORISATION
  RECRUTEMENT
  AUTRE
}

enum AdminRequestStatus {
  EN_ATTENTE
  APPROUVEE
  REJETEE
}

enum ValidationStepStatus {
  EN_ATTENTE
  APPROUVE
  REJETE
}

enum ValidationRunStatus {
  EN_COURS
  APPROUVE
  REJETE
}

// Cahier des charges §19 — derogation de permission scopee par departement
// et/ou projet, en plus du role. GRANT ajoute un droit, DENY le retire
// meme si le role l'accorde normalement.
enum PermissionEffect {
  GRANT
  DENY
}

// Cahier des charges §15 — moteur générique déclencheur → action, sans
// développement. N'importe quel déclencheur peut être associé à n'importe
// quelle action (comme Zapier/IFTTT) ; seuls les champs de config
// pertinents pour l'action choisie sont utilisés à l'exécution.
enum AutomationTrigger {
  TASK_COMPLETED
  TASK_VALIDATION_REJECTED
  DEADLINE_APPROACHING
  PROJECT_COMPLETED
  // Ajoutes (cahier des charges §22) : declencheurs evalues par le cron
  // quotidien (src/app/api/cron/daily-checks/route.ts), pas a la visite.
  TASK_OVERDUE
  PROJECT_OVERDUE
  BUDGET_EXCEEDED
  RISK_CRITICAL
}

enum AutomationActionType {
  CREATE_NEXT_TASK
  SEND_REMINDER
  NOTIFY_STAKEHOLDERS
  // Ajoutes (cahier des charges §22)
  ESCALATE_TO_MANAGER
  MARK_TASK_BLOCKED
}

// Cahier des charges §21 — cadre générique de connexion à des systèmes
// externes (AfriGes, M365, WhatsApp...). Sans identifiants réels disponibles,
// ce MVP fournit l'enregistrement des connexions et un webhook entrant
// générique validé par clé partagée, mais n'appelle aucun service tiers.
enum IntegrationType {
  AFRIGES
  M365
  WHATSAPP
  AUTRE
}

enum IntegrationStatus {
  CONNECTE
  DECONNECTE
  ERREUR
}

model User {
  id                         String      @id @default(cuid())
  name                       String
  email                      String      @unique
  passwordHash               String
  image                      String?
  roleId                     String
  role                       Role        @relation(fields: [roleId], references: [id])
  departmentId               String?
  department                 Department? @relation(fields: [departmentId], references: [id])
  // Poste / fonction (cahier des charges §I, "Postes / Fonctions") — libelle
  // libre historique, distinct du Role qui porte les permissions. posteId
  // est le rattachement structure (avec responsabilites) recommande pour
  // les nouveaux comptes ; les deux coexistent pour ne pas perdre les
  // libelles libres deja saisis.
  poste                      String?
  posteId                    String?
  posteRef                   Poste?      @relation(fields: [posteId], references: [id])
  // Site / agence de rattachement (cahier des charges §I).
  siteId                     String?
  site                       Site?       @relation(fields: [siteId], references: [id])
  // Rattachement hierarchique individuel (cahier des charges §I) — distinct
  // du departementId : deux collaborateurs du meme departement peuvent avoir
  // des managers differents, et un manager peut superviser des gens d'autres
  // departements (organisation matricielle).
  managerId                  String?
  manager                    User?       @relation("UserManager", fields: [managerId], references: [id])
  directReports              User[]      @relation("UserManager")
  isActive                   Boolean     @default(true)
  // Base de calcul du taux d'occupation (cahier des charges §14).
  capaciteHebdomadaireHeures Decimal     @default(35) @db.Decimal(5, 2)
  // Authentification à deux facteurs (cahier des charges §22). mfaSecret
  // n'est renseigné qu'après confirmation (voir src/actions/security.actions.ts) ;
  // mfaBackupCodes stocke des codes de secours hashés (bcrypt), à usage unique.
  mfaEnabled                 Boolean     @default(false)
  mfaSecret                  String?
  mfaBackupCodes             Json?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  projectsOwned                    Project[]                   @relation("ProjectResponsable")
  projectsCreated                  Project[]                   @relation("ProjectCreatedBy")
  projectsSponsored                Project[]                   @relation("ProjectSponsor")
  projectMemberships               ProjectMember[]
  risksResponsable                 ProjectRisk[]               @relation("RiskResponsable")
  risksCreated                     ProjectRisk[]               @relation("RiskCreatedBy")
  stakeholderLinks                 ProjectStakeholder[]        @relation("StakeholderUser")
  deliverablesResponsable          ProjectDeliverable[]        @relation("DeliverableResponsable")
  deliverablesCreated              ProjectDeliverable[]        @relation("DeliverableCreatedBy")
  programmeRisksResponsable        ProgrammeRisk[]             @relation("ProgrammeRiskResponsable")
  programmeRisksCreated            ProgrammeRisk[]             @relation("ProgrammeRiskCreatedBy")
  delegationsGiven                 Delegation[]                @relation("DelegationDelegant")
  delegationsReceived              Delegation[]                @relation("DelegationDelegataire")
  delegationsCreated               Delegation[]                @relation("DelegationCreatedBy")
  organizationProfilesUpdated      OrganizationProfile[]
  strategicAxesCreated             StrategicAxis[]
  tasksOwned                       Task[]                      @relation("TaskResponsablePrincipal")
  tasksCreated                     Task[]                      @relation("TaskCreatedBy")
  taskAssignments                  TaskAssignee[]
  comments                         TaskComment[]
  auditLogs                        AuditLog[]
  meetingsCreated                  Meeting[]                   @relation("MeetingCreatedBy")
  meetingParticipations            MeetingParticipant[]
  meetingDecisionsOwned            MeetingDecision[]           @relation("MeetingDecisionResponsable")
  documentFoldersCreated           DocumentFolder[]            @relation("DocumentFolderCreatedBy")
  documentsUploaded                Document[]                  @relation("DocumentUploadedBy")
  documentsArchived                Document[]                  @relation("DocumentArchivedBy")
  teamsLed                         Team[]                      @relation("TeamLeader")
  teamsCreated                     Team[]                      @relation("TeamCreatedBy")
  teamMemberships                  TeamMember[]
  projectResourcesCreated          ProjectResource[]           @relation("ProjectResourceCreatedBy")
  competences                      UserCompetence[]
  competencesCreated                Competence[]               @relation("CompetenceCreatedBy")
  documentVersionsCreated          DocumentVersion[]           @relation("DocumentVersionCreatedBy")
  leaveRequests                    Leave[]                     @relation("LeaveRequestedBy")
  leaveDecisions                   Leave[]                     @relation("LeaveDecidedBy")
  eventsCreated                    Event[]                     @relation("EventCreatedBy")
  objectivesOwned                  Objective[]                 @relation("ObjectiveUser")
  objectivesCreated                Objective[]                 @relation("ObjectiveCreatedBy")
  conversationsCreated             Conversation[]              @relation("ConversationCreatedBy")
  conversationMemberships          ConversationParticipant[]
  messagesSent                     Message[]                   @relation("MessageAuthor")
  reactions                        Reaction[]
  notifications                    Notification[]
  automationRulesCreated           AutomationRule[]            @relation("AutomationRuleCreatedBy")
  automationNextTaskFor            AutomationRule[]            @relation("AutomationNextTaskResponsable")
  dashboardPreference              DashboardWidgetPreference?
  integrationsCreated              Integration[]               @relation("IntegrationCreatedBy")
  passwordResetTokens              PasswordResetToken[]
  validationWorkflowsCreated       ValidationWorkflow[]        @relation("ValidationWorkflowCreatedBy")
  taskValidationsSubmitted         TaskValidationRun[]         @relation("TaskValidationSubmittedBy")
  taskApprovalsDecided             TaskApproval[]              @relation("TaskApprovalApprover")
  permissionOverrides              PermissionOverride[]        @relation("PermissionOverrideTarget")
  permissionOverridesCreated       PermissionOverride[]        @relation("PermissionOverrideCreatedBy")
  sectionsResponsable              ProjectSection[]            @relation("SectionResponsable")
  sectionComments                  SectionComment[]            @relation("SectionCommentAuthor")
  whiteboardsUpdated               Whiteboard[]                @relation("WhiteboardUpdatedBy")
  documentAccessGrants             DocumentAccess[]            @relation("DocumentAccessGrantee")
  crmOrganizationsOwned            CrmOrganization[]           @relation("CrmOrganizationOwner")
  crmOrganizationsCreated          CrmOrganization[]           @relation("CrmOrganizationCreatedBy")
  crmContactsOwned                 CrmContact[]                @relation("CrmContactOwner")
  crmContactsCreated               CrmContact[]                @relation("CrmContactCreatedBy")
  crmOpportunitiesOwned            CrmOpportunity[]            @relation("CrmOpportunityOwner")
  crmOpportunitiesCreated          CrmOpportunity[]            @relation("CrmOpportunityCreatedBy")
  crmInteractionsAuthored          CrmInteraction[]            @relation("CrmInteractionAuthor")
  programmesOwned                  Programme[]                 @relation("ProgrammeResponsable")
  programmesCreated                Programme[]                 @relation("ProgrammeCreatedBy")
  adminRequestsCreated             AdminRequest[]              @relation("AdminRequestDemandeur")
  adminRequestValidationsSubmitted AdminRequestValidationRun[] @relation("AdminRequestValidationSubmittedBy")
  adminRequestApprovalsDecided     AdminRequestApproval[]      @relation("AdminRequestApprovalApprover")
  plansOwned                       Plan[]                      @relation("PlanOwner")
  plansCreated                     Plan[]                      @relation("PlanCreatedBy")
  evaluationsRecues                Evaluation[]                @relation("EvaluationEvalue")
  evaluationsMenees                Evaluation[]                @relation("EvaluationEvaluateur")
  evaluationsCreees                Evaluation[]                @relation("EvaluationCreatedBy")
  knowledgeCategoriesCreated       KnowledgeCategory[]         @relation("KnowledgeCategoryCreatedBy")
  knowledgeArticlesAuthored        KnowledgeArticle[]          @relation("KnowledgeArticleAuthor")
  portalAccountsInvited            PortalAccount[]             @relation("PortalAccountInvitedBy")
  courriersResponsable             Courrier[]                  @relation("CourrierResponsable")
  courriersCreated                 Courrier[]                  @relation("CourrierCreatedBy")

  @@index([departmentId])
  @@index([roleId])
}

// Reinitialisation de mot de passe (cf. /api/auth/forgot-password et
// /api/auth/reset-password). tokenHash stocke le hash SHA-256 du token
// envoye par email : seul le hash est persiste, jamais le token en clair.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Role {
  id          String           @id @default(cuid())
  key         RoleKey          @unique
  label       String
  description String?
  isSystem    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id       String           @id @default(cuid())
  key      String           @unique
  label    String
  category String
  roles    RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// Dérogation de permission scopée par département et/ou projet (cahier des
// charges §19 : droits définissables « par rôle, département, projet ou
// équipe » — équipe = membres d'un Projet, cf. ProjectMember). Consultée
// uniquement quand un scope est explicitement passé à
// hasPermission/requirePermission (src/lib/permissions.ts) ; les appels
// existants sans scope ne sont pas affectés.
model PermissionOverride {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation("PermissionOverrideTarget", fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String
  departmentId  String?
  department    Department?      @relation(fields: [departmentId], references: [id])
  projectId     String?
  project       Project?         @relation(fields: [projectId], references: [id])
  effect        PermissionEffect @default(GRANT)
  createdById   String
  createdBy     User             @relation("PermissionOverrideCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  @@index([userId, permissionKey])
  @@index([departmentId])
  @@index([projectId])
}

model Department {
  id                  String               @id @default(cuid())
  name                String
  code                String               @unique
  parentId            String?
  parent              Department?          @relation("DeptHierarchy", fields: [parentId], references: [id])
  children            Department[]         @relation("DeptHierarchy")
  users               User[]
  projects            Project[]
  objectives          Objective[]
  permissionOverrides PermissionOverride[]
  adminRequests       AdminRequest[]
  plans               Plan[]
  evaluations         Evaluation[]
  courriers           Courrier[]
  postes              Poste[]
  sites               Site[]
  teams               Team[]
  createdAt           DateTime             @default(now())
}

// Équipe (cahier des charges §I "Structures... Équipes" et niveau 5 du
// pilotage §XXIII) : regroupement de travail au sein d'un département,
// distinct de la hierarchie Direction/Departement/Service (qui est la
// profondeur de l'arbre Department) — une équipe est un groupe transverse
// ou informel, pas un niveau organisationnel supplementaire.
model Team {
  id           String   @id @default(cuid())
  nom          String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  leaderId     String?
  leader       User?    @relation("TeamLeader", fields: [leaderId], references: [id])
  createdById  String
  createdBy    User     @relation("TeamCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  members      TeamMember[]
  conversation Conversation?

  @@index([departmentId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
}

// Profil de l'organisation (cahier des charges §I "Profil de l'organisation"
// et §III "Vision / Mission / Valeurs") — ligne unique (id fixe "org-profile"),
// pas de vraie table multi-tenant : ce logiciel pilote une seule organisation.
model OrganizationProfile {
  id          String   @id @default("org-profile")
  nom         String   @default("Mon organisation")
  logoUrl     String?
  description String?
  vision      String?
  mission     String?
  valeurs     String?
  siteWeb     String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// Poste / fonction structure (cahier des charges §I) — un poste peut etre
// occupe par plusieurs collaborateurs (ex: "Developpeur Backend"), porte ses
// propres responsabilites plutot que le simple libelle texte User.poste.
model Poste {
  id              String      @id @default(cuid())
  nom             String
  description     String?
  // Champ texte libre historique, conserve pour compatibilite. La liste
  // structuree ci-dessous (responsabilitesListe) est la version §I
  // "Responsabilités" utilisable comme un vrai registre (une ligne par
  // responsabilite, reordonnable) plutot qu'un paragraphe.
  responsabilites String?
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  users                User[]
  responsabilitesListe PosteResponsabilite[]

  @@index([departmentId])
}

// Registre structure des responsabilites d'un poste (cahier des charges §I).
model PosteResponsabilite {
  id      String @id @default(cuid())
  posteId String
  poste   Poste  @relation(fields: [posteId], references: [id], onDelete: Cascade)
  libelle String
  ordre   Int    @default(0)

  @@index([posteId])
}

// Site / agence (cahier des charges §I, "Sites / agences, Localisations").
model Site {
  id           String      @id @default(cuid())
  nom          String
  ville        String?
  pays         String?
  adresse      String?
  latitude     Float?
  longitude    Float?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users User[]

  @@index([departmentId])
}

// Delegation temporaire d'autorite (cahier des charges §I, "Delegations")
// — un enregistrement traçable de qui delegue a qui et pourquoi, sur une
// periode donnee. Volontairement un simple registre consultable (pas de
// reroutage automatique des circuits de validation existants, qui resterait
// une extension separee).
model Delegation {
  id            String   @id @default(cuid())
  delegantId    String
  delegant      User     @relation("DelegationDelegant", fields: [delegantId], references: [id])
  delegataireId String
  delegataire   User     @relation("DelegationDelegataire", fields: [delegataireId], references: [id])
  motif         String?
  dateDebut     DateTime
  dateFin       DateTime
  createdById   String
  createdBy     User     @relation("DelegationCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@index([delegantId])
  @@index([delegataireId])
}

// Cahier des charges §IV — planification multi-niveaux. STRATEGIQUE/ANNUEL
// se placent au niveau organisation (departmentId nul) ou d'une direction ;
// TRIMESTRIEL/MENSUEL sont plus souvent departementaux. `parentId` porte la
// cascade (ex: un plan trimestriel rattache a son plan annuel).
enum PlanNiveau {
  STRATEGIQUE
  ANNUEL
  TRIMESTRIEL
  MENSUEL
}

// Conteneur de planification (periode + budget indicatif + priorites), sous
// lequel des Objectifs et des Programmes peuvent etre rattaches pour rendre
// visible la cascade strategie -> objectifs -> travail. Reutilise
// ProjectStatus pour le cycle de vie, comme Programme.
// Axe strategique (cahier des charges §III, "Axes strategiques / Priorites
// strategiques") — entite structuree remplacant le texte libre Plan.priorites
// pour les plans et objectifs qui veulent s'y rattacher explicitement.
// priorite reutilise l'echelle ProjectPriority (meme semantique).
model StrategicAxis {
  id          String          @id @default(cuid())
  nom         String
  description String?
  priorite    ProjectPriority @default(MOYENNE)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  plans      Plan[]
  objectives Objective[]
}

model Plan {
  id              String         @id @default(cuid())
  nom             String
  niveau          PlanNiveau
  description     String?
  dateDebut       DateTime
  dateFin         DateTime
  budgetIndicatif Decimal?       @db.Decimal(14, 2)
  priorites       String?
  // Rattachement structure (cahier des charges §III), coexiste avec le
  // champ texte libre priorites ci-dessus plutot que de le remplacer.
  axisId          String?
  axis            StrategicAxis? @relation(fields: [axisId], references: [id])
  statut          ProjectStatus  @default(PLANIFIE)
  // Nul = plan a l'echelle de toute l'organisation.
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  parentId        String?
  parent          Plan?          @relation("PlanHierarchy", fields: [parentId], references: [id])
  children        Plan[]         @relation("PlanHierarchy")
  ownerId         String
  owner           User           @relation("PlanOwner", fields: [ownerId], references: [id])
  createdById     String
  createdBy       User           @relation("PlanCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  objectives Objective[]
  programmes Programme[]
  tasks      Task[]

  @@index([departmentId])
  @@index([parentId])
  @@index([niveau])
}

// Regroupe plusieurs projets sous une meme initiative strategique (cahier
// des charges §V, ex: Programme "Expansion regionale" -> projets Benin,
// Ghana, Cote d'Ivoire, Burkina Faso). Reutilise ProjectStatus (meme cycle
// de vie planifie/en cours/en pause/termine/annule qu'un projet) plutot que
// d'introduire un enum dedie.
model Programme {
  id            String        @id @default(cuid())
  nom           String
  description   String?
  objectif      String?
  responsableId String
  responsable   User          @relation("ProgrammeResponsable", fields: [responsableId], references: [id])
  statut        ProjectStatus @default(PLANIFIE)
  budget        Decimal?      @db.Decimal(14, 2)
  // Cout reel cumule du programme (distinct du cumul des budgets projets,
  // deja calcule a la volee) — meme principe manuel que Project.coutReel.
  coutReel      Decimal?      @db.Decimal(14, 2)
  dateDebut     DateTime?
  dateFin       DateTime?
  planId        String?
  plan          Plan?         @relation(fields: [planId], references: [id])
  createdById   String
  createdBy     User          @relation("ProgrammeCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  projects   Project[]
  objectives Objective[]
  risks      ProgrammeRisk[]

  @@index([responsableId])
}

// Registre des risques au niveau programme (cahier des charges §V) — meme
// structure que ProjectRisk (memes enums RiskProbability/RiskImpact/
// RiskStatus, deux systemes paralleles plutot qu'une relation polymorphe).
model ProgrammeRisk {
  id             String          @id @default(cuid())
  programmeId    String
  programme      Programme       @relation(fields: [programmeId], references: [id])
  titre          String
  description    String?
  probabilite    RiskProbability @default(MOYENNE)
  impact         RiskImpact      @default(MOYEN)
  statut         RiskStatus      @default(IDENTIFIE)
  planMitigation String?
  responsableId  String?
  responsable    User?           @relation("ProgrammeRiskResponsable", fields: [responsableId], references: [id])
  createdById    String
  createdBy      User            @relation("ProgrammeRiskCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([programmeId])
}

model Project {
  id            String          @id @default(cuid())
  nom           String
  description   String?
  objectif      String?
  responsableId String
  responsable   User            @relation("ProjectResponsable", fields: [responsableId], references: [id])
  departmentId  String
  department    Department      @relation(fields: [departmentId], references: [id])
  programmeId   String?
  programme     Programme?      @relation(fields: [programmeId], references: [id])
  priorite      ProjectPriority @default(MOYENNE)
  // Sponsor (cahier des charges §VI) — porteur hierarchique du projet,
  // distinct du chef de projet operationnel (responsableId).
  sponsorId     String?
  sponsor       User?           @relation("ProjectSponsor", fields: [sponsorId], references: [id])
  dateDebut     DateTime?
  dateFin       DateTime?
  // Localisation (cahier des charges §VI, vue "Carte") — libelle libre
  // (ville/pays) affiche dans les popups, latitude/longitude pour le
  // placement du pin. Les trois sont optionnels : un projet sans
  // coordonnees reste simplement absent de la carte.
  localisation  String?
  latitude      Float?
  longitude     Float?
  budget        Decimal?        @db.Decimal(14, 2)
  // Cout reel a date (cahier des charges §14 — alerte "Budget depasse").
  // Suivi manuel, meme principe que Task.tempsReelHeures : pas de module de
  // depenses detaille, juste un montant que le responsable met a jour.
  coutReel      Decimal?        @db.Decimal(14, 2)
  statut        ProjectStatus   @default(PLANIFIE)
  avancement    Int             @default(0)
  organisation  String?
  createdById   String
  createdBy     User            @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  members             ProjectMember[]
  sections            ProjectSection[]
  tasks               Task[]
  meetings            Meeting[]
  documentFolders     DocumentFolder[]
  documents           Document[]
  events              Event[]
  objectives          Objective[]
  automationRules     AutomationRule[]
  permissionOverrides PermissionOverride[]
  whiteboard          Whiteboard?
  conversation        Conversation?
  risks               ProjectRisk[]
  stakeholders        ProjectStakeholder[]
  milestones          ProjectMilestone[]
  deliverables        ProjectDeliverable[]
  autoTaskWorkflows   ValidationWorkflow[]
  evaluations         Evaluation[]
  decisions           MeetingDecision[]
  indicators          Indicator[]
  resources           ProjectResource[]

  @@index([departmentId])
  @@index([responsableId])
  @@index([statut])
}

// Tableau blanc collaboratif (cahier des charges §7) — un canevas par projet,
// formes/notes persistees en JSON (remplacement complet a chaque sauvegarde).
// Pas de synchronisation temps reel multi-utilisateurs dans cette version
// (necessiterait une infra WebSocket hors perimetre actuel) : chaque
// sauvegarde ecrase la precedente, comme un document partage classique.
model Whiteboard {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id])
  content     Json
  updatedById String
  updatedBy   User     @relation("WhiteboardUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

model ProjectMember {
  id            String            @id @default(cuid())
  projectId     String
  userId        String
  roleOnProject ProjectMemberRole @default(MEMBRE)
  project       Project           @relation(fields: [projectId], references: [id])
  user          User              @relation(fields: [userId], references: [id])
  addedAt       DateTime          @default(now())

  @@unique([projectId, userId])
}

enum RiskProbability {
  FAIBLE
  MOYENNE
  ELEVEE
}

enum RiskImpact {
  FAIBLE
  MOYEN
  ELEVE
}

enum RiskStatus {
  IDENTIFIE
  EN_TRAITEMENT
  MAITRISE
  SURVENU
  CLOS
}

// Registre des risques (cahier des charges §VI — "Un projet possede : ...
// Risques"). Probabilite x impact restent des estimations manuelles
// affichees cote a cote ; pas de score calcule automatiquement, le statut
// resume l'etat reel du risque.
model ProjectRisk {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id])
  titre          String
  description    String?
  probabilite    RiskProbability @default(MOYENNE)
  impact         RiskImpact      @default(MOYEN)
  statut         RiskStatus      @default(IDENTIFIE)
  planMitigation String?
  responsableId  String?
  responsable    User?           @relation("RiskResponsable", fields: [responsableId], references: [id])
  createdById    String
  createdBy      User            @relation("RiskCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([projectId])
}

enum StakeholderNiveau {
  FAIBLE
  MOYEN
  ELEVE
}

// Partie prenante (cahier des charges §VI) — distincte de ProjectMember :
// une partie prenante n'est pas forcement sur l'equipe (sponsor externe,
// direction, client), et peut etre interne (User) ou externe (CrmContact),
// ou ni l'un ni l'autre (simple nom/role en texte libre).
model ProjectStakeholder {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id])
  nom       String
  role      String?
  userId    String?
  user      User?             @relation("StakeholderUser", fields: [userId], references: [id])
  contactId String?
  contact   CrmContact?       @relation(fields: [contactId], references: [id])
  influence StakeholderNiveau @default(MOYEN)
  interet   StakeholderNiveau @default(MOYEN)
  notes     String?
  createdAt DateTime          @default(now())

  @@index([projectId])
}

enum MilestoneStatus {
  A_VENIR
  ATTEINT
  MANQUE
}

// Jalon (cahier des charges §VI — "Un projet possede : ... Jalons"),
// distinct d'une tache : un jalon est un point de controle daté, pas une
// unite de travail assignable.
model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
  nom         String
  description String?
  dateCible   DateTime
  statut      MilestoneStatus @default(A_VENIR)
  ordre       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
}

enum DeliverableStatus {
  A_FAIRE
  EN_COURS
  SOUMIS
  VALIDE
  REJETE
}

// Livrable (cahier des charges §VI). Jusqu'ici seuls les documents lies a
// une tache en tenaient lieu de facon informelle (cf. Task.externalContactId) ;
// ceci donne un cycle de vie propre au niveau du projet, independant du
// module documentaire.
model ProjectDeliverable {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id])
  nom           String
  description   String?
  statut        DeliverableStatus @default(A_FAIRE)
  echeance      DateTime?
  responsableId String?
  responsable   User?             @relation("DeliverableResponsable", fields: [responsableId], references: [id])
  createdById   String
  createdBy     User              @relation("DeliverableCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([projectId])
}

// Ressource de projet (cahier des charges §VI) : registre distinct de
// l'equipe (ProjectMember) — materiel, budget alloue a une ligne precise,
// prestation externe... Type libre plutot qu'un enum ferme, la nature des
// ressources variant trop d'un projet a l'autre.
model ProjectResource {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  nom           String
  type          String?
  quantite      Decimal? @db.Decimal(10, 2)
  unite         String?
  coutUnitaire  Decimal? @db.Decimal(14, 2)
  notes         String?
  createdById   String
  createdBy     User     @relation("ProjectResourceCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@index([projectId])
}

// ─── CRM relationnel ──────────────────────────────────────────────────────
// Premier lot du module CRM (cahier des charges "AfriSime Work-Flow" §II) :
// referentiel contacts/organisations + pipeline d'opportunites + historique
// d'interactions. Volontairement pas encore relie a Project/Task (le champ
// libre Project.organisation n'est pas transforme en relation ici) — prevu
// comme lot separe une fois ce referentiel en place. Pas de suppression
// (hard delete) : comme Project/Task, seuls des changements de statut.

enum CrmOrganizationType {
  ENTREPRISE
  INSTITUTION
  PARTENAIRE
  FOURNISSEUR
  INVESTISSEUR
  AUTRE
}

enum CrmContactType {
  CLIENT
  PROSPECT
  PARTENAIRE
  FOURNISSEUR
  CONSULTANT
  PRESTATAIRE
  CANDIDAT
  MEMBRE
  INVESTISSEUR
  AUTRE
}

enum CrmOpportunityStatus {
  NOUVEAU
  QUALIFICATION
  PROPOSITION
  NEGOCIATION
  GAGNEE
  PERDUE
}

enum CrmInteractionType {
  EMAIL
  APPEL
  WHATSAPP
  REUNION
  VISITE
  NOTE
  MESSAGE
  EVENEMENT
}

model CrmOrganization {
  id          String              @id @default(cuid())
  nom         String
  type        CrmOrganizationType @default(ENTREPRISE)
  secteur     String?
  siteWeb     String?
  telephone   String?
  email       String?
  adresse     String?
  notes       String?
  ownerId     String?
  owner       User?               @relation("CrmOrganizationOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User                @relation("CrmOrganizationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  contacts      CrmContact[]
  opportunities CrmOpportunity[]
  interactions  CrmInteraction[]

  @@index([ownerId])
  @@index([nom])
}

model CrmContact {
  id             String           @id @default(cuid())
  prenom         String
  nom            String
  email          String?
  telephone      String?
  fonction       String?
  type           CrmContactType   @default(PROSPECT)
  source         String?
  // Scoring/segmentation (cahier des charges §II, "Scoring / Segmentation").
  // score : 0-100, saisi manuellement (pas de modele de scoring automatique
  // dans ce MVP). segment : texte libre plutot qu'un enum ferme, les
  // segments d'une organisation variant trop pour etre figes en base.
  score          Int?
  segment        String?
  // Relance planifiee (cahier des charges §II, "Relances") — complete
  // l'alerte automatique "client sans suivi 30 jours" du cron quotidien par
  // une date de relance choisie manuellement par le proprietaire du contact.
  prochaineRelance DateTime?
  organizationId String?
  organization   CrmOrganization? @relation(fields: [organizationId], references: [id])
  notes          String?
  ownerId        String?
  owner          User?            @relation("CrmContactOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      User             @relation("CrmContactCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  opportunities CrmOpportunity[]
  interactions  CrmInteraction[]
  portalAccount PortalAccount?
  missions      Task[]
  stakeholderOf ProjectStakeholder[]
  documentsUploaded Document[] @relation("DocumentUploadedByContact")

  @@index([organizationId])
  @@index([ownerId])
  @@index([nom])
}

// Portail client (cahier des charges §II) — un contact CRM externe (un
// client, sans compte User interne) obtient sa propre connexion pour suivre
// ses opportunites et son historique d'echanges. Session separee du
// systeme d'auth interne (cookie et JWT distincts, cf. src/lib/portal-auth.ts) :
// ce n'est pas un User, pas de role/permissions, juste un acces en lecture
// scope a son propre contact/organisation.
model PortalAccount {
  id           String     @id @default(cuid())
  contactId    String     @unique
  contact      CrmContact @relation(fields: [contactId], references: [id])
  email        String     @unique
  passwordHash String?
  isActive     Boolean    @default(true)
  invitedById  String
  invitedBy    User       @relation("PortalAccountInvitedBy", fields: [invitedById], references: [id])
  activatedAt  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())

  inviteTokens PortalInviteToken[]
}

// Meme patron que PasswordResetToken : token a usage unique, seul le hash
// est persiste.
model PortalInviteToken {
  id              String        @id @default(cuid())
  portalAccountId String
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  tokenHash       String        @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([portalAccountId])
}

model CrmOpportunity {
  id                 String               @id @default(cuid())
  nom                String
  contactId          String?
  contact            CrmContact?          @relation(fields: [contactId], references: [id])
  organizationId     String?
  organization       CrmOrganization?     @relation(fields: [organizationId], references: [id])
  statut             CrmOpportunityStatus @default(NOUVEAU)
  montantEstime      Decimal?             @db.Decimal(14, 2)
  probabilite        Int?
  source             String?
  dateClotureEstimee DateTime?
  raisonPerte        String?
  notes              String?
  ownerId            String
  owner              User                 @relation("CrmOpportunityOwner", fields: [ownerId], references: [id])
  createdById        String
  createdBy          User                 @relation("CrmOpportunityCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  interactions CrmInteraction[]

  @@index([contactId])
  @@index([organizationId])
  @@index([ownerId])
  @@index([statut])
}

model CrmInteraction {
  id              String             @id @default(cuid())
  type            CrmInteractionType
  contenu         String
  dateInteraction DateTime           @default(now())
  contactId       String?
  contact         CrmContact?        @relation(fields: [contactId], references: [id])
  organizationId  String?
  organization    CrmOrganization?   @relation(fields: [organizationId], references: [id])
  opportunityId   String?
  opportunity     CrmOpportunity?    @relation(fields: [opportunityId], references: [id])
  authorId        String
  author          User               @relation("CrmInteractionAuthor", fields: [authorId], references: [id])
  createdAt       DateTime           @default(now())

  @@index([contactId])
  @@index([organizationId])
  @@index([opportunityId])
}

// Phase / Sous-phase / Lot — un seul modèle auto-référencé, discriminé par
// `type`. Chaque niveau a son responsable, ses échéances (dateDebut/dateFin),
// ses documents et ses commentaires (cahier des charges §5).
model ProjectSection {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id])
  parentId      String?
  parent        ProjectSection?  @relation("SectionHierarchy", fields: [parentId], references: [id])
  children      ProjectSection[] @relation("SectionHierarchy")
  type          SectionType
  nom           String
  description   String?
  responsableId String?
  responsable   User?            @relation("SectionResponsable", fields: [responsableId], references: [id])
  dateDebut     DateTime?
  dateFin       DateTime?
  statut        SectionStatus    @default(A_VENIR)
  ordre         Int              @default(0)
  tasks         Task[]
  documents     Document[]
  comments      SectionComment[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId])
  @@index([parentId])
  @@index([responsableId])
}

// Commentaire sur une section (Phase/Sous-phase/Lot) — miroir de TaskComment
// pour que ce niveau ait aussi un fil de discussion (cahier des charges §5).
model SectionComment {
  id        String         @id @default(cuid())
  sectionId String
  section   ProjectSection @relation(fields: [sectionId], references: [id])
  authorId  String
  author    User           @relation("SectionCommentAuthor", fields: [authorId], references: [id])
  content   String
  createdAt DateTime       @default(now())

  @@index([sectionId])
}

// Tâche / Sous-tâche — un seul modèle auto-référencé (sous-tâche = parentTaskId non nul).
model Task {
  id                     String          @id @default(cuid())
  projectId              String
  project                Project         @relation(fields: [projectId], references: [id])
  sectionId              String?
  section                ProjectSection? @relation(fields: [sectionId], references: [id])
  parentTaskId           String?
  parentTask             Task?           @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subTasks               Task[]          @relation("TaskHierarchy")
  titre                  String
  description            String?
  priorite               TaskPriority    @default(MOYENNE)
  statut                 TaskStatus      @default(A_FAIRE)
  avancement             Int             @default(0)
  // Utilise par la vue Gantt (cahier des charges §7) ; distinct de createdAt
  // qui est la date de creation de l'enregistrement, pas la date de debut
  // prevue du travail.
  dateDebut              DateTime?
  echeance               DateTime?
  // Renseigné/vidé à la transition vers/depuis TERMINEE — sert au calcul du
  // respect des délais (cahier des charges §16), distinct de updatedAt qui
  // change à chaque modification.
  completedAt            DateTime?
  tempsEstimeHeures      Decimal?        @db.Decimal(6, 2)
  tempsReelHeures        Decimal?        @db.Decimal(6, 2)
  responsablePrincipalId String
  responsablePrincipal   User            @relation("TaskResponsablePrincipal", fields: [responsablePrincipalId], references: [id])
  // Mission deleguee a un prestataire/partenaire externe (cahier des
  // charges §XXI — "portail prestataire, avec missions et livrables").
  // Le contact CRM externe voit alors cette tache dans son portail ; ses
  // documents lies (deja existants) en tiennent lieu de livrables.
  externalContactId      String?
  externalContact        CrmContact?     @relation(fields: [externalContactId], references: [id])
  // Origines supplementaires (cahier des charges §IX — "la tache peut
  // provenir : ... d'un objectif ... d'un plan"). Optionnelles et
  // independantes du projet, purement traceabilite.
  objectiveId            String?
  objective              Objective?      @relation(fields: [objectiveId], references: [id])
  planId                 String?
  plan                   Plan?           @relation(fields: [planId], references: [id])
  // Traçabilité de l'origine "workflow" (cahier des charges §IX) : vrai
  // quand la tâche a été créée automatiquement par un circuit de validation
  // (ValidationWorkflow.creerTacheAlApprobation) ou une règle d'automatisation
  // (AutomationRule action CREATE_NEXT_TASK), plutôt que saisie manuellement.
  creeParWorkflow        Boolean         @default(false)
  createdById            String
  createdBy              User            @relation("TaskCreatedBy", fields: [createdById], references: [id])
  ordre                  Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  assignees       TaskAssignee[]
  checklistItems  ChecklistItem[]
  comments        TaskComment[]
  documents       Document[]
  dependsOn       TaskDependency[]   @relation("DependentTask")
  blocking        TaskDependency[]   @relation("PrerequisiteTask")
  meetingDecision MeetingDecision?
  validationRun   TaskValidationRun?
  courrier        Courrier?
  adminRequest    AdminRequest?
  indicators      Indicator[]

  @@index([projectId])
  @@index([sectionId])
  @@index([parentTaskId])
  @@index([responsablePrincipalId])
  @@index([externalContactId])
  @@index([objectiveId])
  @@index([planId])
  @@index([statut])
  @@index([echeance])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  label     String
  isDone    Boolean  @default(false)
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions Reaction[]

  @@index([taskId])
}

model TaskDependency {
  id              String         @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  type            DependencyType @default(BLOQUE)
  task            Task           @relation("DependentTask", fields: [taskId], references: [id])
  dependsOnTask   Task           @relation("PrerequisiteTask", fields: [dependsOnTaskId], references: [id])
  createdAt       DateTime       @default(now())

  @@unique([taskId, dependsOnTaskId])
}

// Circuit de validation configurable (cahier des charges §9, ex: Demande →
// Responsable → Directeur → DG). Défini une fois par un admin, réutilisé
// pour chaque tâche soumise à validation de ce type d'entité.
model ValidationWorkflow {
  id                      String               @id @default(cuid())
  nom                     String
  entityType              ValidationEntityType
  // Condition de selection du circuit (cahier des charges §VIII) — ne
  // s'applique qu'aux demandes administratives (entityType=ADMIN_REQUEST) :
  // adminRequestType nul = s'applique a tous les types ; montantMin nul =
  // aucun plancher. getActiveAdminRequestWorkflow() choisit le circuit
  // actif le plus specifique (voir src/lib/admin-request-workflow.ts).
  adminRequestType        AdminRequestType?
  montantMin              Decimal?             @db.Decimal(14, 2)
  isActive                Boolean              @default(true)
  // Action automatique a l'approbation complete (cahier des charges §VIII,
  // ex. "Mission creee" en fin de circuit) — cree une Task liee via
  // AdminRequest.taskId, dans autoTaskProjectId (requis si active).
  creerTacheAlApprobation Boolean              @default(false)
  autoTaskProjectId       String?
  autoTaskProject         Project?             @relation(fields: [autoTaskProjectId], references: [id])
  createdById             String
  createdBy               User                 @relation("ValidationWorkflowCreatedBy", fields: [createdById], references: [id])
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  steps            ValidationWorkflowStep[]
  runs             TaskValidationRun[]
  // Meme catalogue de circuits que les taches, mais instances separees
  // (voir AdminRequestValidationRun) : pas de relation polymorphe cote
  // Prisma, donc deux relations plutot qu'une seule generique.
  adminRequestRuns AdminRequestValidationRun[]

  @@index([entityType, isActive])
}

// Une étape du circuit, dans l'ordre `ordre` — l'approbateur est désigné par
// rôle (ex: RESPONSABLE puis DIRECTEUR puis DIRECTEUR_GENERAL).
model ValidationWorkflowStep {
  id            String             @id @default(cuid())
  workflowId    String
  workflow      ValidationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  ordre         Int
  approverRole  RoleKey
  label         String?
  // Escalade (cahier des charges §VIII) — si l'etape n'est pas decidee
  // depuis plus de escaladeJours, le cron quotidien notifie en plus les
  // titulaires de escaladeRole (approvers normaux toujours notifies aussi).
  escaladeJours Int?
  escaladeRole  RoleKey?
  // Condition d'applicabilite de l'etape (cahier des charges §VIII,
  // "Condition") — ne s'applique qu'aux demandes administratives (montant
  // renseigne) ; null = pas de condition, l'etape s'applique toujours. Si le
  // montant de la demande ne satisfait pas la condition, l'etape est
  // ignoree automatiquement (voir decideAdminRequestCurrentStep) plutot que
  // bloquer le circuit sur une etape qui n'a pas lieu d'etre.
  montantMin    Decimal?             @db.Decimal(14, 2)
  montantMax    Decimal?             @db.Decimal(14, 2)

  approvals             TaskApproval[]
  adminRequestApprovals AdminRequestApproval[]

  @@unique([workflowId, ordre])
}

// Instance en cours (ou terminée) d'un circuit pour une tâche précise.
// `currentOrdre` pointe l'étape active ; historisée et notifiée à chaque
// transition (voir src/actions/task.actions.ts).
model TaskValidationRun {
  id            String              @id @default(cuid())
  taskId        String              @unique
  task          Task                @relation(fields: [taskId], references: [id])
  workflowId    String
  workflow      ValidationWorkflow  @relation(fields: [workflowId], references: [id])
  statut        ValidationRunStatus @default(EN_COURS)
  currentOrdre  Int                 @default(1)
  submittedById String
  submittedBy   User                @relation("TaskValidationSubmittedBy", fields: [submittedById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  approvals TaskApproval[]

  @@index([taskId])
}

// Décision (approuvé/rejeté) prise à une étape précise d'une instance de
// circuit — une ligne par étape, créée EN_ATTENTE dès la soumission.
model TaskApproval {
  id          String                 @id @default(cuid())
  runId       String
  run         TaskValidationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId      String
  step        ValidationWorkflowStep @relation(fields: [stepId], references: [id])
  statut      ValidationStepStatus   @default(EN_ATTENTE)
  approverId  String?
  approver    User?                  @relation("TaskApprovalApprover", fields: [approverId], references: [id])
  commentaire String?
  decidedAt   DateTime?
  createdAt   DateTime               @default(now())

  @@unique([runId, stepId])
  @@index([runId])
  @@index([approverId])
}

// Demande administrative generique (achat, mission, decaissement, materiel,
// autorisation, recrutement...) soumise immediatement au circuit de
// validation actif de type ADMIN_REQUEST des sa creation (pas d'etat
// brouillon, comme Leave). Les conges restent geres par Leave, pas ici.
model AdminRequest {
  id           String             @id @default(cuid())
  type         AdminRequestType
  titre        String
  description  String?
  montant      Decimal?           @db.Decimal(14, 2)
  dateDebut    DateTime?
  dateFin      DateTime?
  demandeurId  String
  demandeur    User               @relation("AdminRequestDemandeur", fields: [demandeurId], references: [id])
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  statut       AdminRequestStatus @default(EN_ATTENTE)
  // Tache/mission generee automatiquement a l'approbation complete du
  // circuit (cahier des charges §VIII, ex. "Demande de mission -> ... ->
  // Mission creee") — voir ValidationWorkflow.creerTacheAlApprobation.
  // Meme pattern que Courrier.taskId : la tache est un rattachement
  // optionnel, pas une propriete intrinseque de la demande.
  taskId       String?            @unique
  task         Task?              @relation(fields: [taskId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  validationRun AdminRequestValidationRun?

  @@index([demandeurId])
  @@index([statut])
}

// Miroir exact de TaskValidationRun, pour AdminRequest.
model AdminRequestValidationRun {
  id             String              @id @default(cuid())
  adminRequestId String              @unique
  adminRequest   AdminRequest        @relation(fields: [adminRequestId], references: [id])
  workflowId     String
  workflow       ValidationWorkflow  @relation(fields: [workflowId], references: [id])
  statut         ValidationRunStatus @default(EN_COURS)
  currentOrdre   Int                 @default(1)
  submittedById  String
  submittedBy    User                @relation("AdminRequestValidationSubmittedBy", fields: [submittedById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  approvals AdminRequestApproval[]

  @@index([adminRequestId])
}

// Miroir exact de TaskApproval, pour AdminRequestValidationRun.
model AdminRequestApproval {
  id          String                    @id @default(cuid())
  runId       String
  run         AdminRequestValidationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId      String
  step        ValidationWorkflowStep    @relation(fields: [stepId], references: [id])
  statut      ValidationStepStatus      @default(EN_ATTENTE)
  approverId  String?
  approver    User?                     @relation("AdminRequestApprovalApprover", fields: [approverId], references: [id])
  commentaire String?
  decidedAt   DateTime?
  createdAt   DateTime                  @default(now())

  @@unique([runId, stepId])
  @@index([runId])
  @@index([approverId])
}

// Registre de courrier (cahier des charges §VII) — entrant/sortant/interne,
// avec cycle de vie a traiter -> en cours -> traite -> archive. Distinct des
// Demandes administratives (pas de circuit de validation ici, juste un
// registre suivi par un responsable) et de Document (le fichier joint est
// une simple URL, pas de versioning).
enum CourrierType {
  ENTRANT
  SORTANT
  INTERNE
}

enum CourrierStatus {
  A_TRAITER
  EN_COURS
  TRAITE
  ARCHIVE
}

model Courrier {
  id            String         @id @default(cuid())
  // Genere a la creation, format CRR-{annee}-{sequence}, ex. CRR-2026-0001.
  reference     String         @unique
  objet         String
  type          CourrierType
  statut        CourrierStatus @default(A_TRAITER)
  confidentiel  Boolean        @default(false)
  dateCourrier  DateTime
  // Texte libre : l'expediteur/destinataire n'est pas toujours un contact
  // CRM ou un utilisateur interne (ex. administration publique, particulier).
  expediteur    String?
  destinataire  String?
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  responsableId String?
  responsable   User?          @relation("CourrierResponsable", fields: [responsableId], references: [id])
  documentUrl   String?
  documentNom   String?
  notes         String?
  taskId        String?        @unique
  task          Task?          @relation(fields: [taskId], references: [id])
  createdById   String
  createdBy     User           @relation("CourrierCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([departmentId])
  @@index([responsableId])
  @@index([statut])
  @@index([type])
}

enum MeetingRecurrence {
  AUCUNE
  HEBDOMADAIRE
  MENSUELLE
}

model Meeting {
  id                    String            @id @default(cuid())
  projectId             String
  project               Project           @relation(fields: [projectId], references: [id])
  titre                 String
  dateHeure             DateTime
  lieu                  String?
  ordreDuJour           String?
  compteRendu           String?
  statut                MeetingStatus     @default(PLANIFIEE)
  // Reunions recurrentes (cahier des charges §XI) — recurrence renseignee
  // seulement sur la reunion "mere" ; les occurrences generees pointent
  // vers elle via recurrenceParentId, ce qui les regroupe en serie sans
  // avoir a parser une regle RRULE.
  recurrence            MeetingRecurrence @default(AUCUNE)
  recurrenceParentId    String?
  recurrenceParent      Meeting?          @relation("MeetingRecurrence", fields: [recurrenceParentId], references: [id])
  recurrenceOccurrences Meeting[]         @relation("MeetingRecurrence")
  createdById           String
  createdBy             User              @relation("MeetingCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  participants MeetingParticipant[]
  decisions    MeetingDecision[]
  documents    Document[]

  @@index([projectId])
  @@index([dateHeure])
  @@index([recurrenceParentId])
}

model MeetingParticipant {
  meetingId String
  userId    String
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([meetingId, userId])
}

// Une décision/action peut donner naissance à une Task (cahier des charges
// §8 : « les actions décidées deviennent automatiquement des tâches »).
// Decision (cahier des charges §VI/§X) : issue d'une reunion (meetingId) OU
// prise directement au niveau projet sans reunion (projectId) — exactement
// l'un des deux est renseigne, verifie en application plutot qu'en
// contrainte DB (meme pattern que Reaction.taskCommentId/messageId).
enum DecisionStatus {
  EN_COURS
  TRAITEE
  ANNULEE
}

model MeetingDecision {
  id            String         @id @default(cuid())
  meetingId     String?
  meeting       Meeting?       @relation(fields: [meetingId], references: [id])
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id])
  description   String
  // Motif (cahier des charges §XI) — pourquoi cette decision, distinct de
  // la description de l'action elle-meme.
  motif         String?
  statut        DecisionStatus @default(EN_COURS)
  responsableId String?
  responsable   User?          @relation("MeetingDecisionResponsable", fields: [responsableId], references: [id])
  echeance      DateTime?
  taskId        String?        @unique
  task          Task?          @relation(fields: [taskId], references: [id])
  createdAt     DateTime       @default(now())

  @@index([meetingId])
  @@index([projectId])
}

// Dossier documentaire d'un projet — auto-référencé pour le classement en
// sous-dossiers (cahier des charges §10 : « classement par dossiers »).
model DocumentFolder {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id])
  parentId    String?
  parent      DocumentFolder?  @relation("DocumentFolderHierarchy", fields: [parentId], references: [id])
  children    DocumentFolder[] @relation("DocumentFolderHierarchy")
  nom         String
  createdById String
  createdBy   User             @relation("DocumentFolderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  documents Document[]

  @@index([projectId])
  @@index([parentId])
}

// Un document appartient toujours à un projet ; il peut en plus être lié à
// une tâche ou une réunion (cahier des charges §10 : « les documents
// peuvent être liés à des tâches ou à des réunions »). Le contrôle d'accès
// s'appuie sur les permissions document.* et l'appartenance au projet
// (ProjectMember), pas sur une liste d'accès par document.
// Type de document (cahier des charges §16) — permet de distinguer un
// contrat (suivi de signature) d'un simple fichier de travail.
enum DocumentType {
  CONTRAT
  RAPPORT
  FACTURE
  PROCES_VERBAL
  LIVRABLE
  AUTRE
}

// Statut de signature (cahier des charges §16), pertinent surtout pour les
// documents de type CONTRAT mais laisse disponible pour tout document.
enum DocumentSignatureStatus {
  NON_REQUISE
  EN_ATTENTE
  SIGNE
  REFUSE
}

// Validation client d'un livrable (cahier des charges §21) : un membre
// interne marque un document comme "a valider" une fois le livrable pret ;
// le partenaire/prestataire concerne (Task.externalContactId) le valide ou
// le rejette depuis le portail. Independant de statutSignature (signature de
// contrat) qui repond a un besoin different.
enum DocumentValidationStatus {
  NON_REQUISE
  EN_ATTENTE
  VALIDE
  REJETE
}

model Document {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id])
  folderId     String?
  folder       DocumentFolder? @relation(fields: [folderId], references: [id])
  sectionId    String?
  section      ProjectSection? @relation(fields: [sectionId], references: [id])
  taskId       String?
  task         Task?           @relation(fields: [taskId], references: [id])
  meetingId    String?
  meeting      Meeting?        @relation(fields: [meetingId], references: [id])
  messageId    String?
  message      Message?        @relation(fields: [messageId], references: [id])
  nom          String
  description  String?
  url          String
  mimeType     String?
  sizeBytes    Int?
  type             DocumentType            @default(AUTRE)
  statutSignature  DocumentSignatureStatus @default(NON_REQUISE)
  dateSignature    DateTime?
  // Archivage (cahier des charges §17) : un document archive reste consultable
  // mais disparait des listes par defaut (voir estArchive dans les filtres).
  estArchive       Boolean                 @default(false)
  dateArchivage    DateTime?
  archivedById     String?
  archivedBy       User?                   @relation("DocumentArchivedBy", fields: [archivedById], references: [id])
  validationExterne            DocumentValidationStatus @default(NON_REQUISE)
  dateValidationExterne        DateTime?
  commentaireValidationExterne String?
  // Un document depose depuis le portail externe (cahier des charges §21) a
  // uploadedByContactId renseigne et uploadedById null ; l'inverse pour un
  // depot interne classique — jamais les deux a la fois.
  uploadedById String?
  uploadedBy   User?           @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedByContactId String?
  uploadedByContact   CrmContact? @relation("DocumentUploadedByContact", fields: [uploadedByContactId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  versions     DocumentVersion[]
  accessGrants DocumentAccess[]

  @@index([projectId])
  @@index([folderId])
  @@index([sectionId])
  @@index([taskId])
  @@index([meetingId])
  @@index([messageId])
  @@index([type])
  @@index([estArchive])
}

// Controle d'acces par document (cahier des charges §10). Sans ligne pour un
// document : acces regi par les permissions document.* + appartenance au
// projet, comme avant (comportement par defaut inchange). Des qu'au moins
// une ligne existe, le document devient "prive" : seuls l'uploader et les
// utilisateurs listes ici peuvent le consulter, meme s'ils ont acces au
// projet.
model DocumentAccess {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("DocumentAccessGrantee", fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
}

// Historique des modifications (cahier des charges §10) : chaque nouvelle
// version crée une entrée ; `Document` reflète toujours la version courante.
model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  url         String
  mimeType    String?
  sizeBytes   Int?
  note        String?
  createdById String
  createdBy   User     @relation("DocumentVersionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([documentId])
}

// Base de connaissances (cahier des charges §13) — wiki d'entreprise,
// distinct des Document (fichiers uploadés, toujours rattachés a un projet) :
// un article est du contenu texte libre, rattache a l'organisation entiere
// via un arbre de categories (meme principe self-referential que
// DocumentFolder/Department), pas a un projet. Pas d'historique de versions
// separe (contrairement a DocumentVersion) : editer un article le modifie
// en place, updatedAt suffit pour un wiki interne.
enum KnowledgeArticleStatus {
  BROUILLON
  PUBLIE
}

// Compétences (cahier des charges §XII, "Évaluation individuelle :
// Compétences") — catalogue global géré en administration, assignation
// libre-service par collaborateur (comme un CV structuré).
enum CompetenceNiveau {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
  EXPERT
}

model Competence {
  id          String   @id @default(cuid())
  nom         String   @unique
  categorie   String?
  createdById String
  createdBy   User     @relation("CompetenceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  users UserCompetence[]
}

model UserCompetence {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  competenceId String
  competence   Competence       @relation(fields: [competenceId], references: [id])
  niveau       CompetenceNiveau @default(DEBUTANT)
  notes        String?
  createdAt    DateTime         @default(now())

  @@unique([userId, competenceId])
  @@index([userId])
  @@index([competenceId])
}

model KnowledgeCategory {
  id          String              @id @default(cuid())
  nom         String
  parentId    String?
  parent      KnowledgeCategory?  @relation("KnowledgeCategoryHierarchy", fields: [parentId], references: [id])
  children    KnowledgeCategory[] @relation("KnowledgeCategoryHierarchy")
  createdById String
  createdBy   User                @relation("KnowledgeCategoryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())

  articles KnowledgeArticle[]

  @@index([parentId])
}

model KnowledgeArticle {
  id          String                 @id @default(cuid())
  titre       String
  content     String
  tags        String?
  statut      KnowledgeArticleStatus @default(BROUILLON)
  categoryId  String?
  category    KnowledgeCategory?     @relation(fields: [categoryId], references: [id])
  authorId    String
  author      User                   @relation("KnowledgeArticleAuthor", fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([statut])
}

// Congé (cahier des charges §12 : le calendrier consolide tâches, réunions,
// congés et événements). Validation simple par une personne habilitée
// (leave.manage), pas un circuit de validation à plusieurs étapes.
model Leave {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation("LeaveRequestedBy", fields: [userId], references: [id])
  type        LeaveType   @default(CONGE_PAYE)
  dateDebut   DateTime
  dateFin     DateTime
  motif       String?
  statut      LeaveStatus @default(EN_ATTENTE)
  decidedById String?
  decidedBy   User?       @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([dateDebut])
  @@index([dateFin])
}

// Événement générique du calendrier consolidé — sans projet, c'est un
// événement d'entreprise ; avec projet, visible dans le calendrier de ce
// projet uniquement.
model Event {
  id          String    @id @default(cuid())
  titre       String
  description String?
  dateDebut   DateTime
  dateFin     DateTime?
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  createdById String
  createdBy   User      @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([projectId])
  @@index([dateDebut])
}

// Objectif (cahier des charges §13) — annuel/trimestriel/mensuel/hebdomadaire,
// individuel/équipe (= membres d'un Projet)/département. Exactement un des
// champs userId/projectId/departmentId est renseigné selon `scope`.
model Objective {
  id           String          @id @default(cuid())
  titre        String
  description  String?
  periode      ObjectivePeriod
  scope        ObjectiveScope
  dateDebut    DateTime
  dateFin      DateTime
  statut       ObjectiveStatus @default(EN_COURS)
  userId       String?
  user         User?           @relation("ObjectiveUser", fields: [userId], references: [id])
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id])
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id])
  // Portee PROGRAMME (cahier des charges §V, menu "Objectifs" du programme).
  programmeId  String?
  programme    Programme?      @relation(fields: [programmeId], references: [id])
  planId       String?
  plan         Plan?           @relation(fields: [planId], references: [id])
  // Rattachement a un axe strategique (cahier des charges §III), optionnel
  // quelle que soit la portee de l'objectif.
  axisId       String?
  axis         StrategicAxis?  @relation(fields: [axisId], references: [id])
  // Cahier des charges §III — cascade d'objectifs (entreprise -> direction
  // -> equipe -> individuel), independante du rattachement a un Plan.
  parentId     String?
  parent       Objective?      @relation("ObjectiveHierarchy", fields: [parentId], references: [id])
  children     Objective[]     @relation("ObjectiveHierarchy")
  createdById  String
  createdBy    User            @relation("ObjectiveCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  indicators Indicator[]
  tasks      Task[]

  @@index([userId])
  @@index([projectId])
  @@index([departmentId])
  @@index([programmeId])
  @@index([planId])
  @@index([axisId])
  @@index([parentId])
  @@index([periode])
}

// Indicateur mesurable relié à un objectif (cahier des charges §13).
// KPI (cahier des charges §VI/§IX) : rattache a un Objective, un Project ou
// une Task — exactement un des trois, verifie en application (meme pattern
// que MeetingDecision ci-dessus). Le rattachement Objective reste le cas
// historique (Resultats cles/OKR) ; Project/Task etendent le meme modele
// plutot que d'en dupliquer un.
model Indicator {
  id             String     @id @default(cuid())
  objectiveId    String?
  objective      Objective? @relation(fields: [objectiveId], references: [id])
  projectId      String?
  project        Project?   @relation(fields: [projectId], references: [id])
  taskId         String?
  task           Task?      @relation(fields: [taskId], references: [id])
  nom            String
  unite          String?
  valeurCible    Decimal    @db.Decimal(12, 2)
  valeurActuelle Decimal    @default(0) @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([objectiveId])
  @@index([projectId])
  @@index([taskId])
}

// Cahier des charges §14 — évaluation de performance périodique. Flux à
// deux parties (évaluateur note, évalué accuse réception) sur le modèle de
// Leave plutôt que le circuit ValidationWorkflow multi-étapes : pas besoin
// d'une chaîne de rôles configurable ici, juste un aller-retour.
enum EvaluationPeriode {
  ANNUELLE
  SEMESTRIELLE
  TRIMESTRIELLE
}

enum EvaluationStatus {
  BROUILLON
  SOUMISE
  ACCUSE_RECEPTION
}

// Cahier des charges §XII — "Types d'evaluation". PERIODIQUE n'est pas un
// type distinct ici : c'est deja porte par Evaluation.periode, applicable a
// n'importe lequel des 4 types ci-dessous.
enum EvaluationType {
  MANAGER
  AUTO
  PAIRS_360
  PROJET
}

model Evaluation {
  id                    String            @id @default(cuid())
  type                  EvaluationType    @default(MANAGER)
  periode               EvaluationPeriode
  dateDebut             DateTime
  dateFin               DateTime
  evalueId              String
  evalue                User              @relation("EvaluationEvalue", fields: [evalueId], references: [id])
  evaluateurId          String
  evaluateur            User              @relation("EvaluationEvaluateur", fields: [evaluateurId], references: [id])
  // Departement de l'evalue au moment de la creation — fige pour les
  // rapports meme si l'evalue change ensuite de departement.
  departmentId          String?
  department            Department?       @relation(fields: [departmentId], references: [id])
  // Renseigne seulement pour type=PROJET (cahier des charges §XII).
  projectId             String?
  project               Project?          @relation(fields: [projectId], references: [id])
  pointsForts           String?
  axesAmelioration      String?
  commentaireEvaluateur String?
  commentaireEvalue     String?
  scoreGlobal           Decimal?          @db.Decimal(3, 2)
  statut                EvaluationStatus  @default(BROUILLON)
  dateSoumission        DateTime?
  dateAccuseReception   DateTime?
  createdById           String
  createdBy             User              @relation("EvaluationCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  criteres EvaluationCritere[]

  @@index([evalueId])
  @@index([evaluateurId])
  @@index([departmentId])
  @@index([projectId])
  @@index([dateDebut])
}

// Critère individuel noté (ex : "Qualité du travail", "Ponctualité") —
// même principe qu'Indicator, mais pour une évaluation.
model EvaluationCritere {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  libelle      String
  note         Decimal    @db.Decimal(3, 2)
  commentaire  String?
  createdAt    DateTime   @default(now())

  @@index([evaluationId])
}

// Messagerie interne (cahier des charges §11). Une conversation à deux
// participants est une messagerie directe ; `isGroup` + `nom` distinguent
// une discussion de groupe.
// Une conversation privee n'a pas de projet (projectId null). Une conversation
// de projet (cahier des charges §10 : « fil de discussion par projet ») a
// projectId renseigne et unique : un seul canal par projet, dont les
// participants sont synchronises sur l'equipe projet (voir
// src/lib/project-conversation.ts) plutot que geres manuellement.
model Conversation {
  id          String   @id @default(cuid())
  nom         String?
  isGroup     Boolean  @default(false)
  projectId   String?  @unique
  project     Project? @relation(fields: [projectId], references: [id])
  // Conversation d'equipe (cahier des charges §X), meme principe que
  // projectId ci-dessus : un seul canal par equipe, participants
  // synchronises sur TeamMember plutot que geres manuellement.
  teamId      String?  @unique
  team        Team?    @relation(fields: [teamId], references: [id])
  createdById String
  createdBy   User     @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  joinedAt       DateTime     @default(now())
  // Horodatage de la derniere ouverture de la conversation par ce
  // participant (mis a jour par markConversationRead). Les messages des
  // autres posterieurs a cette date sont "non lus". Null tant que la
  // conversation n'a jamais ete ouverte.
  lastReadAt     DateTime?

  @@id([conversationId, userId])
}

// Piece jointe (cahier des charges §11 : « partage de fichiers ») portee
// directement par le message plutot que par un Document : une conversation
// n'a pas de projectId (contrairement a Document.projectId, obligatoire),
// donc un fichier partage en messagerie ne peut pas legitimement devenir un
// Document du modele documentaire de projet.
model Message {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id])
  authorId            String
  author              User         @relation("MessageAuthor", fields: [authorId], references: [id])
  content             String
  attachmentUrl       String?
  attachmentNom       String?
  attachmentMimeType  String?
  attachmentSizeBytes Int?
  createdAt           DateTime     @default(now())

  reactions Reaction[]
  documents Document[]

  @@index([conversationId])
}

// Réaction à un message ou à un commentaire de tâche — exactement un des
// deux champs taskCommentId/messageId est renseigné. Une contrainte unique
// par cible empêche la même personne de poser deux fois le même emoji (les
// valeurs NULL de l'autre cible ne bloquent rien, Postgres les traite comme
// distinctes).
model Reaction {
  id            String       @id @default(cuid())
  emoji         String
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  taskCommentId String?
  taskComment   TaskComment? @relation(fields: [taskCommentId], references: [id])
  messageId     String?
  message       Message?     @relation(fields: [messageId], references: [id])
  createdAt     DateTime     @default(now())

  @@unique([userId, taskCommentId, emoji])
  @@unique([userId, messageId, emoji])
}

// Notifications in-app (cahier des charges §18). `entityType`/`entityId`
// permettent de dédupliquer les notifications générées à la volée
// (échéance proche / retard) plutôt que de les régénérer à chaque visite.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       NotificationType
  titre      String
  lien       String?
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@unique([userId, type, entityType, entityId])
  @@index([userId, isRead])
}

// Règle d'automatisation (cahier des charges §15) — rattachée à un projet.
// Les champs de configuration sont tous optionnels au niveau du modèle ;
// seuls ceux pertinents pour `action` sont utilisés à l'exécution
// (voir src/lib/automation.ts).
model AutomationRule {
  id        String               @id @default(cuid())
  projectId String
  project   Project              @relation(fields: [projectId], references: [id])
  nom       String
  trigger   AutomationTrigger
  action    AutomationActionType
  isActive  Boolean              @default(true)

  // Config action CREATE_NEXT_TASK
  nextTaskTitre         String?
  nextTaskResponsableId String?
  nextTaskResponsable   User?   @relation("AutomationNextTaskResponsable", fields: [nextTaskResponsableId], references: [id])
  nextTaskDelaiJours    Int?

  // Config action SEND_REMINDER / déclencheur DEADLINE_APPROACHING
  reminderDelaiJours Int?

  createdById String
  createdBy   User     @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions AutomationExecution[]

  @@index([projectId])
  @@index([trigger])
}

// Journal d'exécution — rend le moteur transparent (pas une boîte noire) :
// on peut voir quand une règle s'est déclenchée et ce qu'elle a produit.
model AutomationExecution {
  id         String         @id @default(cuid())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id])
  entityType String
  entityId   String
  resultat   String
  executedAt DateTime       @default(now())

  @@index([ruleId])
}

// Générique — sert aussi d'historique des modifications de tâche/projet.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Connexion à un système externe (cahier des charges §21). `apiKey` est le
// secret partagé attendu sur les webhooks entrants (en-tête `x-api-key`) —
// masqué à l'affichage, jamais exposé après création. Aucun appel sortant
// réel n'est effectué dans ce MVP (pas d'identifiants tiers disponibles).
model Integration {
  id          String            @id @default(cuid())
  nom         String
  type        IntegrationType
  statut      IntegrationStatus @default(DECONNECTE)
  apiKey      String?
  webhookUrl  String?
  description String?
  lastSyncAt  DateTime?
  createdById String
  createdBy   User              @relation("IntegrationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  events IntegrationEvent[]
}

// Journal des webhooks entrants reçus pour une intégration.
model IntegrationEvent {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  eventType     String
  payload       Json
  receivedAt    DateTime    @default(now())

  @@index([integrationId])
}

// Préférences de widgets du tableau de bord (cahier des charges §16 :
// « les widgets sont configurables »). `widgets` est un tableau JSON de clés
// dans l'ordre d'affichage souhaité ; l'absence de ligne = tous les widgets,
// dans l'ordre par défaut (voir src/lib/dashboard-widgets.ts).
model DashboardWidgetPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  widgets   Json
  updatedAt DateTime @updatedAt
}
