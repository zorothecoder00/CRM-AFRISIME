// ===================== V2.2 §14-§15 — Scenario planning & simulation =====================
// Un seul modele pour les deux modules : §15 ("simulation organisationnelle")
// est explicitement une comparaison de plusieurs instances de §14
// ("scenario planning"). Parametres a plat (pas de Json) : chaque scenario du
// cahier des charges ne combine qu'un seul levier a la fois (sauf
// NOUVELLE_FILIALE, cas particulier gere en delta absolu plutot qu'en %).
// Estimation par regle de proportionnalite simple (src/lib/
// scenario-simulation.ts), pas une simulation ML — presente comme telle a
// l'affichage.
enum ScenarioType {
  EFFECTIF
  RESSOURCES
  PROJETS
  NOUVELLE_FILIALE
  PERSONNALISE
}

model Scenario {
  id                      String       @id @default(cuid())
