// Decision Intelligence (cahier des charges V3.0 §37) — "le système doit
// conserver l'historique des décisions et mesurer leurs conséquences"
// (ex. "Ouvrir une nouvelle agence" -> 6 mois plus tard : objectif atteint,
// coût réel, délai, performance, incidents, ROI, enseignements).
// sourceType/sourceId (optionnels, même convention que Dependency) relient
// à une MeetingDecision/GovernanceDecision existante quand la décision est
// déjà tracée là — sinon la décision est purement décrite ici (titre/
// description), pour couvrir aussi les décisions qui ne passent pas par un
// circuit de réunion formel.
model DecisionOutcome {
  id                   String    @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationDecisionOutcomes", fields: [organizationId], references: [id])
  titre                String
  description          String?
  sourceType           String?
  sourceId             String?
  dateDecision         DateTime
  dateEvaluationPrevue DateTime?
  objectifAtteint      Boolean?
  coutReel             Decimal?  @db.Decimal(14, 2)
  delaiJours           Int?
  performance          String?
  incidents            String?
  roiPercent           Decimal?  @db.Decimal(6, 2)
  enseignements        String?
  evaluatedAt          DateTime?
  evaluatedById        String?
  evaluatedBy          User?     @relation("DecisionOutcomeEvaluatedBy", fields: [evaluatedById], references: [id])
  createdById          String
  createdBy            User      @relation("DecisionOutcomeCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([sourceType, sourceId])
}

// Poste / fonction structure (cahier des charges §I) — un poste peut etre
// occupe par plusieurs collaborateurs (ex: "Developpeur Backend"), porte ses
// propres responsabilites plutot que le simple libelle texte User.poste.
model Poste {
  id              String      @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que
  // DecisionOutcome. Pas de createdBy sur ce modele (referentiel, pas une
  // transaction utilisateur) : rattache via department si renseigne, sinon
  // par le backfill comme les autres modeles sans parent direct.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationPostes", fields: [organizationId], references: [id])
  nom             String
  description     String?
  // Champ texte libre historique, conserve pour compatibilite. La liste
  // structuree ci-dessous (responsabilitesListe) est la version §I
  // "Responsabilités" utilisable comme un vrai registre (une ligne par
  // responsabilite, reordonnable) plutot qu'un paragraphe.
  responsabilites String?
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  // Poste critique (cahier des charges V3.0 §24, "postes critiques") — signale
  // manuellement un poste dont la vacance ferait courir un risque à
  // l'organisation ; alimente le plan de succession (SuccessionPlan) et le
  // Workforce Planning (§22).
  critique        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  users                User[]
  responsabilitesListe PosteResponsabilite[]
  successionPlans      SuccessionPlan[]

  @@index([departmentId])
}

// Registre structure des responsabilites d'un poste (cahier des charges §I).
model PosteResponsabilite {
  id      String @id @default(cuid())
  posteId String
  poste   Poste  @relation(fields: [posteId], references: [id], onDelete: Cascade)
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que Poste,
  // denormalise depuis poste.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationPosteResponsabilites", fields: [organizationId], references: [id])
  libelle String
  ordre   Int    @default(0)

  @@index([posteId])
}

// Talent & Succession Planning (cahier des charges V3.0 §24) — prévoit
// progressivement, pour un poste critique, un titulaire et un ou plusieurs
// profils de remplacement avec leur potentiel/délai de disponibilité.
// Volontairement un registre de gestion organisationnelle (postes,
// compétences, plans, potentiel) et non un logiciel RH opérationnel : pas de
// paie, pas d'évaluation formelle dédiée (l'évaluation existante — Evaluation
// — reste la source de vérité sur la performance individuelle).
model SuccessionPlan {
  id                  String               @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que
  // DecisionOutcome, denormalise depuis createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationSuccessionPlans", fields: [organizationId], references: [id])
  posteId             String
  poste               Poste                @relation(fields: [posteId], references: [id])
  titulaireId         String?
  titulaire           User?                @relation("SuccessionPlanTitulaire", fields: [titulaireId], references: [id])
  competencesRequises String?
  statut              SuccessionPlanStatut @default(EN_PREPARATION)
  notes               String?
  createdById         String
  createdBy           User                 @relation("SuccessionPlanCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  profils SuccessionCandidate[]

  @@index([posteId])
  @@index([titulaireId])
}

model SuccessionCandidate {
  id               String          @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que
  // SuccessionPlan, denormalise depuis successionPlan.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationSuccessionCandidates", fields: [organizationId], references: [id])
  successionPlanId String
  successionPlan   SuccessionPlan  @relation(fields: [successionPlanId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation("SuccessionCandidateUser", fields: [userId], references: [id])
  potentiel        PotentielNiveau @default(MOYEN)
  pretDans         String?
  notes            String?
  createdAt        DateTime        @default(now())

  @@unique([successionPlanId, userId])
  @@index([successionPlanId])
}

enum SuccessionPlanStatut {
  EN_PREPARATION
  PRET
  ACTIF
}

enum PotentielNiveau {
  FAIBLE
  MOYEN
  ELEVE
}

// Site / agence (cahier des charges §I, "Sites / agences, Localisations").
model Site {
  id           String      @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que Poste (pas
  // de createdBy, referentiel).
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationSites", fields: [organizationId], references: [id])
  nom          String
  ville        String?
  pays         String?
  adresse      String?
  latitude     Float?
  longitude    Float?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users User[]

  @@index([departmentId])
}

// Delegation temporaire d'autorite (cahier des charges §I, "Delegations")
// — un enregistrement traçable de qui delegue a qui et pourquoi, sur une
// periode donnee. Volontairement un simple registre consultable (pas de
// reroutage automatique des circuits de validation existants, qui resterait
// une extension separee).
model Delegation {
  id            String   @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que
  // DecisionOutcome, denormalise depuis createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationDelegations", fields: [organizationId], references: [id])
  delegantId    String
  delegant      User     @relation("DelegationDelegant", fields: [delegantId], references: [id])
  delegataireId String
  delegataire   User     @relation("DelegationDelegataire", fields: [delegataireId], references: [id])
  motif         String?
  dateDebut     DateTime
  dateFin       DateTime
  createdById   String
  createdBy     User     @relation("DelegationCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@index([delegantId])
  @@index([delegataireId])
}

// Cahier des charges §IV — planification multi-niveaux. STRATEGIQUE/ANNUEL
// se placent au niveau organisation (departmentId nul) ou d'une direction ;
// TRIMESTRIEL/MENSUEL sont plus souvent departementaux. `parentId` porte la
// cascade (ex: un plan trimestriel rattache a son plan annuel).
enum PlanNiveau {
  STRATEGIQUE
  ANNUEL
  TRIMESTRIEL
  MENSUEL
}

// Conteneur de planification (periode + budget indicatif + priorites), sous
// lequel des Objectifs et des Programmes peuvent etre rattaches pour rendre
// visible la cascade strategie -> objectifs -> travail. Reutilise
// ProjectStatus pour le cycle de vie, comme Programme.
// Axe strategique (cahier des charges §III, "Axes strategiques / Priorites
// strategiques") — entite structuree remplacant le texte libre Plan.priorites
// pour les plans et objectifs qui veulent s'y rattacher explicitement.
// priorite reutilise l'echelle ProjectPriority (meme semantique).
model StrategicAxis {
  id          String          @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que
  // DecisionOutcome, denormalise depuis createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationStrategicAxes", fields: [organizationId], references: [id])
  nom         String
  description String?
  priorite    ProjectPriority @default(MOYENNE)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  plans      Plan[]
  objectives Objective[]
}

enum SwotCategory {
  FORCE
  FAIBLESSE
  OPPORTUNITE
  MENACE
}

// Analyse SWOT (cahier des charges V3.0 §10 "Strategy Copilot" — "analyse
// SWOT"). Organisation entiere, pas rattachee a un axe strategique precis :
// le cahier ne demande pas de granularite plus fine et StrategicAxis reste
// deja rattachable aux Plans/Objectifs independamment de ce module.
model SwotItem {
  id          String       @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que
  // DecisionOutcome, denormalise depuis createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationSwotItems", fields: [organizationId], references: [id])
  categorie   SwotCategory
  contenu     String
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([categorie])
}

model Plan {
  id              String         @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que
  // DecisionOutcome, denormalise depuis createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationPlans", fields: [organizationId], references: [id])
  nom             String
  niveau          PlanNiveau
  description     String?
  dateDebut       DateTime
  dateFin         DateTime
  budgetIndicatif Decimal?       @db.Decimal(14, 2)
  priorites       String?
  // Rattachement structure (cahier des charges §III), coexiste avec le
  // champ texte libre priorites ci-dessus plutot que de le remplacer.
  axisId          String?
  axis            StrategicAxis? @relation(fields: [axisId], references: [id])
  statut          ProjectStatus  @default(PLANIFIE)
  // Nul = plan a l'echelle de toute l'organisation.
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  parentId        String?
  parent          Plan?          @relation("PlanHierarchy", fields: [parentId], references: [id])
  children        Plan[]         @relation("PlanHierarchy")
  ownerId         String
  owner           User           @relation("PlanOwner", fields: [ownerId], references: [id])
  createdById     String
  createdBy       User           @relation("PlanCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  objectives Objective[]
  programmes Programme[]
  tasks      Task[]

  @@index([departmentId])
  @@index([parentId])
  @@index([niveau])
}

// Regroupe plusieurs projets sous une meme initiative strategique (cahier
// des charges §V, ex: Programme "Expansion regionale" -> projets Benin,
// Ghana, Cote d'Ivoire, Burkina Faso). Reutilise ProjectStatus (meme cycle
// de vie planifie/en cours/en pause/termine/annule qu'un projet) plutot que
// d'introduire un enum dedie.
model Programme {
  id            String        @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que
  // DecisionOutcome, denormalise depuis createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationProgrammes", fields: [organizationId], references: [id])
  nom           String
  description   String?
  objectif      String?
  responsableId String
  responsable   User          @relation("ProgrammeResponsable", fields: [responsableId], references: [id])
  statut        ProjectStatus @default(PLANIFIE)
  budget        Decimal?      @db.Decimal(14, 2)
  // Cout reel cumule du programme (distinct du cumul des budgets projets,
  // deja calcule a la volee) — meme principe manuel que Project.coutReel.
  coutReel      Decimal?      @db.Decimal(14, 2)
  dateDebut     DateTime?
  dateFin       DateTime?
  planId        String?
  plan          Plan?         @relation(fields: [planId], references: [id])
  createdById   String
  createdBy     User          @relation("ProgrammeCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  projects      Project[]
  objectives    Objective[]
  risks         ProgrammeRisk[]
  beneficiaires Beneficiaire[]

  @@index([responsableId])
}

// Registre des risques au niveau programme (cahier des charges §V) — meme
// structure que ProjectRisk (memes enums RiskProbability/RiskImpact/
// RiskStatus, deux systemes paralleles plutot qu'une relation polymorphe).
model ProgrammeRisk {
  id             String          @id @default(cuid())
  // Multi-tenant Phase 1 lot 11 (2026-08-20) — meme statut que Programme,
  // denormalise depuis programme.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationProgrammeRisks", fields: [organizationId], references: [id])
  programmeId    String
  programme      Programme       @relation(fields: [programmeId], references: [id])
  titre          String
  description    String?
  probabilite    RiskProbability @default(MOYENNE)
  impact         RiskImpact      @default(MOYEN)
  statut         RiskStatus      @default(IDENTIFIE)
  planMitigation String?
  responsableId  String?
  responsable    User?           @relation("ProgrammeRiskResponsable", fields: [responsableId], references: [id])
  createdById    String
  createdBy      User            @relation("ProgrammeRiskCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([programmeId])
}

model Project {
  id            String          @id @default(cuid())
  nom           String
  description   String?
  objectif      String?
  responsableId String
  responsable   User            @relation("ProjectResponsable", fields: [responsableId], references: [id])
  departmentId  String
  department    Department      @relation(fields: [departmentId], references: [id])
  // Multi-tenant Phase 1 lot 2 (2026-08-20) — meme statut que Team ci-dessus.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationProjects", fields: [organizationId], references: [id])
  programmeId   String?
  programme     Programme?      @relation(fields: [programmeId], references: [id])
  priorite      ProjectPriority @default(MOYENNE)
  // Sponsor (cahier des charges §VI) — porteur hierarchique du projet,
  // distinct du chef de projet operationnel (responsableId).
  sponsorId     String?
  sponsor       User?           @relation("ProjectSponsor", fields: [sponsorId], references: [id])
  dateDebut     DateTime?
  dateFin       DateTime?
  // Localisation (cahier des charges §VI, vue "Carte") — libelle libre
  // (ville/pays) affiche dans les popups, latitude/longitude pour le
  // placement du pin. Les trois sont optionnels : un projet sans
  // coordonnees reste simplement absent de la carte.
  localisation  String?
  latitude      Float?
  longitude     Float?
  budget        Decimal?        @db.Decimal(14, 2)
  // Cout reel a date (cahier des charges §14 — alerte "Budget depasse").
  // Suivi manuel, meme principe que Task.tempsReelHeures : pas de module de
  // depenses detaille, juste un montant que le responsable met a jour.
  coutReel      Decimal?        @db.Decimal(14, 2)
  statut        ProjectStatus   @default(PLANIFIE)
  avancement    Int             @default(0)
  organisation  String?
  createdById   String
  createdBy     User            @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  // Corbeille (cahier des charges V2.2 §37 — "suppression controlee") :
  // "supprimer" un projet le marque au lieu de l'effacer ; purge definitive
  // apres un delai (voir purgeTrash dans src/lib/trash.ts).
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?           @relation("ProjectDeletedBy", fields: [deletedById], references: [id])

  members                ProjectMember[]
  sections               ProjectSection[]
  tasks                  Task[]
  meetings               Meeting[]
  documentFolders        DocumentFolder[]
  documents              Document[]
  events                 Event[]
  objectives             Objective[]
  automationRules        AutomationRule[]
  orchestrationPlaybooks OrchestrationPlaybook[]
  permissionOverrides    PermissionOverride[]
  whiteboard             Whiteboard?
  conversation           Conversation?
  risks                  ProjectRisk[]
  organizationalRisks    OrganizationalRisk[]
  stakeholders           StakeholderProject[]
  milestones             ProjectMilestone[]
  deliverables           ProjectDeliverable[]
  autoTaskWorkflows      ValidationWorkflow[]
  evaluations            Evaluation[]
  decisions              MeetingDecision[]
  indicators             Indicator[]
  resources              ProjectResource[]
  incidents              Incident[]
  beneficiaires          Beneficiaire[]
  decisionMatrices       DecisionMatrix[]

  @@index([departmentId])
  @@index([responsableId])
  @@index([statut])
}

// Tableau blanc collaboratif (cahier des charges §7) — un canevas par projet,
// formes/notes persistees en JSON (remplacement complet a chaque sauvegarde).
// Pas de synchronisation temps reel multi-utilisateurs dans cette version
// (necessiterait une infra WebSocket hors perimetre actuel) : chaque
// sauvegarde ecrase la precedente, comme un document partage classique.
model Whiteboard {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 6 (2026-08-20) — meme statut que Meeting/
  // DocumentFolder : nullable, reversible, denormalise depuis
  // project.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationWhiteboards", fields: [organizationId], references: [id])
  content     Json
  updatedById String
  updatedBy   User     @relation("WhiteboardUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

model ProjectMember {
  id            String            @id @default(cuid())
  projectId     String
  userId        String
  roleOnProject ProjectMemberRole @default(MEMBRE)
  project       Project           @relation(fields: [projectId], references: [id])
  user          User              @relation(fields: [userId], references: [id])
  addedAt       DateTime          @default(now())
  // Multi-tenant Phase 1 lot 6 (2026-08-20) — meme statut que Whiteboard.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationProjectMembers", fields: [organizationId], references: [id])

  @@unique([projectId, userId])
}

enum RiskProbability {
  FAIBLE
  MOYENNE
  ELEVEE
}

enum RiskImpact {
  FAIBLE
  MOYEN
  ELEVE
}

enum RiskStatus {
  IDENTIFIE
  EN_TRAITEMENT
  MAITRISE
  SURVENU
  CLOS
}

// Registre des risques (cahier des charges §VI — "Un projet possede : ...
// Risques"). Probabilite x impact restent des estimations manuelles
// affichees cote a cote ; pas de score calcule automatiquement, le statut
// resume l'etat reel du risque.
model ProjectRisk {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 6 (2026-08-20) — meme statut que Whiteboard.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationProjectRisks", fields: [organizationId], references: [id])
  titre          String
  description    String?
  probabilite    RiskProbability @default(MOYENNE)
  impact         RiskImpact      @default(MOYEN)
  statut         RiskStatus      @default(IDENTIFIE)
  planMitigation String?
  responsableId  String?
  responsable    User?           @relation("RiskResponsable", fields: [responsableId], references: [id])
  createdById    String
  createdBy      User            @relation("RiskCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([projectId])
}

enum StakeholderNiveau {
  FAIBLE
  MOYEN
  ELEVE
}

// Position d'une partie prenante vis-a-vis du projet/de l'organisation
// (cahier des charges V2.2 §21) — echelle a 3 valeurs, meme esprit que
// StakeholderNiveau mais un axe distinct (posture, pas intensite).
enum StakeholderPosition {
  FAVORABLE
  NEUTRE
  OPPOSANT
}

// Partie prenante (cahier des charges §VI, etendu V2.2 §21) — profil
// personne unique, independant du projet : une meme partie prenante peut
// etre associee a plusieurs projets (voir StakeholderProject) au lieu
// d'une ligne dupliquee par projet. Peut etre interne (User), externe
// (CrmContact), ou ni l'un ni l'autre (simple nom en texte libre).
model Stakeholder {
  id                  String               @id @default(cuid())
  // Multi-tenant Phase 1 lot 17 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationStakeholders", fields: [organizationId], references: [id])
  nom                 String
  userId              String?
  user                User?                @relation("StakeholderUser", fields: [userId], references: [id])
  contactId           String?
  contact             CrmContact?          @relation(fields: [contactId], references: [id])
  influence           StakeholderNiveau    @default(MOYEN)
  interet             StakeholderNiveau    @default(MOYEN)
  niveauEngagement    StakeholderNiveau    @default(MOYEN)
  position            StakeholderPosition?
  // Nature de la relation (ex. "Client historique", "Sponsor politique",
  // "Bailleur") — texte libre, trop variable pour un enum ferme.
  relation            String?
  responsableId       String?
  responsable         User?                @relation("StakeholderResponsable", fields: [responsableId], references: [id])
  risquesRelationnels String?
  notes               String?
  createdById         String
  createdBy           User                 @relation("StakeholderCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  projects       StakeholderProject[]
  communications StakeholderCommunication[]

  @@index([userId])
  @@index([contactId])
  @@index([responsableId])
}

// Table de liaison Stakeholder <-> Project (cahier des charges V2.2 §21,
// "projets associes" au pluriel) — role reste contextuel au projet (une
// meme personne peut avoir un role different d'un projet a l'autre), les
// autres attributs (influence/engagement/position/...) vivent sur Stakeholder.
model StakeholderProject {
  id            String      @id @default(cuid())
  // Multi-tenant Phase 1 lot 17 (2026-08-20) — meme statut que Stakeholder,
  // denormalise depuis stakeholder.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationStakeholderProjects", fields: [organizationId], references: [id])
  stakeholderId String
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id])
  role          String?
  createdAt     DateTime    @default(now())

  @@unique([stakeholderId, projectId])
  @@index([projectId])
}

// Fil de communications avec une partie prenante (cahier des charges V2.2
// §21, "communications") — uniforme que la personne soit liee a un
// User/CrmContact ou non, plutot que de dependre de CrmInteraction qui
// suppose un CrmContact.
model StakeholderCommunication {
  id            String      @id @default(cuid())
  // Multi-tenant Phase 1 lot 17 (2026-08-20) — meme statut que Stakeholder,
  // denormalise depuis stakeholder.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationStakeholderCommunications", fields: [organizationId], references: [id])
  stakeholderId String
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  date          DateTime    @default(now())
  canal         String?
  resume        String
  authorId      String
  author        User        @relation("StakeholderCommunicationAuthor", fields: [authorId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([stakeholderId, date])
}

enum MilestoneStatus {
  A_VENIR
  ATTEINT
  MANQUE
}

// Jalon (cahier des charges §VI — "Un projet possede : ... Jalons"),
// distinct d'une tache : un jalon est un point de controle daté, pas une
// unite de travail assignable.
model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 6 (2026-08-20) — meme statut que Whiteboard.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationProjectMilestones", fields: [organizationId], references: [id])
  nom         String
  description String?
  dateCible   DateTime
  statut      MilestoneStatus @default(A_VENIR)
  ordre       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
}

enum DeliverableStatus {
  A_FAIRE
  EN_COURS
  SOUMIS
  VALIDE
  REJETE
}

// Livrable (cahier des charges §VI). Jusqu'ici seuls les documents lies a
// une tache en tenaient lieu de facon informelle (cf. Task.externalContactId) ;
// ceci donne un cycle de vie propre au niveau du projet, independant du
// module documentaire.
model ProjectDeliverable {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 6 (2026-08-20) — meme statut que Whiteboard.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationProjectDeliverables", fields: [organizationId], references: [id])
  nom           String
  description   String?
  statut        DeliverableStatus @default(A_FAIRE)
  echeance      DateTime?
  responsableId String?
  responsable   User?             @relation("DeliverableResponsable", fields: [responsableId], references: [id])
  createdById   String
  createdBy     User              @relation("DeliverableCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([projectId])
}

// Ressource de projet (cahier des charges §VI) : registre distinct de
// l'equipe (ProjectMember) — materiel, budget alloue a une ligne precise,
// prestation externe... Type libre plutot qu'un enum ferme, la nature des
// ressources variant trop d'un projet a l'autre.
model ProjectResource {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 6 (2026-08-20) — meme statut que Whiteboard.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationProjectResources", fields: [organizationId], references: [id])
  nom          String
  type         String?
  quantite     Decimal? @db.Decimal(10, 2)
  unite        String?
  coutUnitaire Decimal? @db.Decimal(14, 2)
  notes        String?
  createdById  String
  createdBy    User     @relation("ProjectResourceCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([projectId])
}

// ─── CRM relationnel ──────────────────────────────────────────────────────
// Premier lot du module CRM (cahier des charges "AfriSime Work-Flow" §II) :
// referentiel contacts/organisations + pipeline d'opportunites + historique
// d'interactions. Volontairement pas encore relie a Project/Task (le champ
// libre Project.organisation n'est pas transforme en relation ici) — prevu
// comme lot separe une fois ce referentiel en place. Pas de suppression
// (hard delete) : comme Project/Task, seuls des changements de statut.

enum CrmOrganizationType {
  ENTREPRISE
  INSTITUTION
  PARTENAIRE
  FOURNISSEUR
  INVESTISSEUR
  AUTRE
}

enum CrmContactType {
  CLIENT
  PROSPECT
  PARTENAIRE
  FOURNISSEUR
  CONSULTANT
  PRESTATAIRE
  CANDIDAT
  MEMBRE
  INVESTISSEUR
  // Écosystème V3.0 (§25) — association, collectif ou groupe d'intérêt
  // rattaché à l'organisation, sans relation commerciale ni contrat.
  COMMUNAUTE
  AUTRE
}

enum CrmOpportunityStatus {
  NOUVEAU
  QUALIFICATION
  PROPOSITION
  NEGOCIATION
  GAGNEE
  PERDUE
}

enum CrmInteractionType {
  EMAIL
  APPEL
  WHATSAPP
  REUNION
  VISITE
  NOTE
  MESSAGE
  EVENEMENT
}

model CrmOrganization {
  id          String              @id @default(cuid())
  // Multi-tenant Phase 1 lot 10 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId. Nomme platformOrganizationId (et non
  // organizationId) pour ne pas entrer en collision avec le sens CRM
  // existant de "organisation" (CrmOrganization = client/partenaire), qui
  // n'a rien a voir avec le tenant PlatformOrganization.
  platformOrganizationId String?
  platformOrganization   PlatformOrganization? @relation("PlatformOrganizationCrmOrganizations", fields: [platformOrganizationId], references: [id])
  nom         String
  type        CrmOrganizationType @default(ENTREPRISE)
  secteur     String?
  siteWeb     String?
  telephone   String?
  email       String?
  adresse     String?
  notes       String?
  ownerId     String?
  owner       User?               @relation("CrmOrganizationOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User                @relation("CrmOrganizationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Rattachement multi-entites (cahier des charges V2.2 §22-23) — direct,
  // voir le meme champ sur CrmContact.
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  contacts      CrmContact[]
  opportunities CrmOpportunity[]
  interactions  CrmInteraction[]
  contracts     Contract[]

  @@index([ownerId])
  @@index([nom])
  @@index([entityId])
}

model CrmContact {
  id               String           @id @default(cuid())
  prenom           String
  nom              String
  email            String?
  telephone        String?
  fonction         String?
  type             CrmContactType   @default(PROSPECT)
  source           String?
  // Scoring/segmentation (cahier des charges §II, "Scoring / Segmentation").
  // score : 0-100, saisi manuellement (pas de modele de scoring automatique
  // dans ce MVP). segment : texte libre plutot qu'un enum ferme, les
  // segments d'une organisation variant trop pour etre figes en base.
  score            Int?
  segment          String?
  // Relance planifiee (cahier des charges §II, "Relances") — complete
  // l'alerte automatique "client sans suivi 30 jours" du cron quotidien par
  // une date de relance choisie manuellement par le proprietaire du contact.
  prochaineRelance DateTime?
  organizationId   String?
  organization     CrmOrganization? @relation(fields: [organizationId], references: [id])
  // Multi-tenant Phase 1 lot 10 (2026-08-20) — meme statut que
  // CrmOrganization.platformOrganizationId (nom distinct pour ne pas
  // entrer en collision avec organizationId ci-dessus, qui designe le
  // CrmOrganization client, pas le tenant).
  platformOrganizationId String?
  platformOrganization   PlatformOrganization? @relation("PlatformOrganizationCrmContacts", fields: [platformOrganizationId], references: [id])
  notes            String?
  ownerId          String?
  owner            User?            @relation("CrmContactOwner", fields: [ownerId], references: [id])
  createdById      String
  createdBy        User             @relation("CrmContactCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Rattachement multi-entites (cahier des charges V2.2 §22-23) — direct
  // (pas derive d'un Department comme pour User/Project) : un contact CRM
  // n'appartient a aucune arborescence departement interne. L'entite
  // effective d'un contact est entityId si renseigne, sinon celle de son
  // organisation (voir src/lib/entity-scope.ts).
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  opportunities      CrmOpportunity[]
  interactions       CrmInteraction[]
  portalAccount      PortalAccount?
  missions           Task[]
  stakeholderOf      Stakeholder[]
  documentsUploaded  Document[]                   @relation("DocumentUploadedByContact")
  qualityClaims      QualityClaim[]
  portalMessages     PortalMessage[]
  meetingInvitations MeetingExternalParticipant[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([nom])
  @@index([entityId])
}

// Portail client (cahier des charges §II) — un contact CRM externe (un
// client, sans compte User interne) obtient sa propre connexion pour suivre
// ses opportunites et son historique d'echanges. Session separee du
// systeme d'auth interne (cookie et JWT distincts, cf. src/lib/portal-auth.ts) :
// ce n'est pas un User, pas de role/permissions, juste un acces en lecture
// scope a son propre contact/organisation.
model PortalAccount {
  id           String     @id @default(cuid())
  contactId    String     @unique
  contact      CrmContact @relation(fields: [contactId], references: [id])
  // Multi-tenant Phase 1 lot 10 (2026-08-20) — meme statut que
  // CrmContact.platformOrganizationId, denormalise depuis
  // contact.platformOrganizationId.
  platformOrganizationId String?
  platformOrganization   PlatformOrganization? @relation("PlatformOrganizationPortalAccounts", fields: [platformOrganizationId], references: [id])
  email        String     @unique
  passwordHash String?
  isActive     Boolean    @default(true)
  invitedById  String
  invitedBy    User       @relation("PortalAccountInvitedBy", fields: [invitedById], references: [id])
  activatedAt  DateTime?
  lastLoginAt  DateTime?
  // Droits granulaires (cahier des charges V3.0 §25, "Ecosystem Management" —
  // chaque acteur externe peut avoir "... + ses droits") : par defaut identiques
  // au comportement V2.2 (tout visible des lors que la donnee existe pour le
  // contact), un administrateur peut les restreindre acteur par acteur sans
  // toucher au systeme de visibilite base sur les donnees (portal-nav-visibility.ts).
  droitProjets       Boolean @default(true)
  droitDocuments     Boolean @default(true)
  droitTeleversement Boolean @default(true)
  droitMessages      Boolean @default(true)
  createdAt    DateTime   @default(now())

  inviteTokens PortalInviteToken[]
}

// Meme patron que PasswordResetToken : token a usage unique, seul le hash
// est persiste.
model PortalInviteToken {
  id              String        @id @default(cuid())
  portalAccountId String
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  // Multi-tenant Phase 1 lot 10 (2026-08-20) — meme statut que PortalAccount.
  platformOrganizationId String?
  platformOrganization   PlatformOrganization? @relation("PlatformOrganizationPortalInviteTokens", fields: [platformOrganizationId], references: [id])
  tokenHash       String        @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([portalAccountId])
}

model CrmOpportunity {
  id                 String               @id @default(cuid())
  nom                String
  contactId          String?
  contact            CrmContact?          @relation(fields: [contactId], references: [id])
  organizationId     String?
  organization       CrmOrganization?     @relation(fields: [organizationId], references: [id])
  // Multi-tenant Phase 1 lot 10 (2026-08-20) — meme statut que
  // CrmContact.platformOrganizationId.
  platformOrganizationId String?
  platformOrganization   PlatformOrganization? @relation("PlatformOrganizationCrmOpportunities", fields: [platformOrganizationId], references: [id])
  statut             CrmOpportunityStatus @default(NOUVEAU)
  montantEstime      Decimal?             @db.Decimal(14, 2)
  probabilite        Int?
  source             String?
  dateClotureEstimee DateTime?
  raisonPerte        String?
  notes              String?
  ownerId            String
  owner              User                 @relation("CrmOpportunityOwner", fields: [ownerId], references: [id])
  createdById        String
  createdBy          User                 @relation("CrmOpportunityCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  interactions CrmInteraction[]
  contracts    Contract[]

  @@index([contactId])
  @@index([organizationId])
  @@index([ownerId])
  @@index([statut])
}

model CrmInteraction {
  id              String             @id @default(cuid())
  type            CrmInteractionType
  contenu         String
  dateInteraction DateTime           @default(now())
  contactId       String?
  contact         CrmContact?        @relation(fields: [contactId], references: [id])
  organizationId  String?
  organization    CrmOrganization?   @relation(fields: [organizationId], references: [id])
  // Multi-tenant Phase 1 lot 10 (2026-08-20) — meme statut que
  // CrmContact.platformOrganizationId.
  platformOrganizationId String?
  platformOrganization   PlatformOrganization? @relation("PlatformOrganizationCrmInteractions", fields: [platformOrganizationId], references: [id])
  opportunityId   String?
  opportunity     CrmOpportunity?    @relation(fields: [opportunityId], references: [id])
  authorId        String
  author          User               @relation("CrmInteractionAuthor", fields: [authorId], references: [id])
  createdAt       DateTime           @default(now())

  @@index([contactId])
  @@index([organizationId])
  @@index([opportunityId])
}

// Contrat (comble V2.2 §7.1 "nouveau contrat" — aucun modèle Contrat
// n'existait, ni ici ni dans le chantier v2.0 §12 encore ouvert). Portée
// volontairement minimale : juste assez pour rattacher un contrat à une
// opportunité/organisation et déclencher CONTRACT_CREATED — une gestion
// contractuelle complète (avenants, échéancier de paiement...) reste le
// travail du futur v2.0 §12, pas de ce module.
enum ContractStatut {
  ACTIF
  EXPIRE
  RESILIE
}

model Contract {
  id             String           @id @default(cuid())
  nom            String
  opportunityId  String?
  opportunity    CrmOpportunity?  @relation(fields: [opportunityId], references: [id])
  organizationId String?
  organization   CrmOrganization? @relation(fields: [organizationId], references: [id])
  // Multi-tenant Phase 1 lot 10 (2026-08-20) — meme statut que
  // CrmContact.platformOrganizationId.
  platformOrganizationId String?
  platformOrganization   PlatformOrganization? @relation("PlatformOrganizationContracts", fields: [platformOrganizationId], references: [id])
  montant        Decimal?         @db.Decimal(14, 2)
  dateSignature  DateTime?
  dateExpiration DateTime?
  statut         ContractStatut   @default(ACTIF)
  createdById    String
  createdBy      User             @relation("ContractCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())

  @@index([opportunityId])
  @@index([organizationId])
}

// Phase / Sous-phase / Lot — un seul modèle auto-référencé, discriminé par
// `type`. Chaque niveau a son responsable, ses échéances (dateDebut/dateFin),
// ses documents et ses commentaires (cahier des charges §5).
model ProjectSection {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 4 (2026-08-20) — meme statut que Task (voir
  // PlatformOrganization dans schema.prisma) : nullable, reversible,
  // denormalise depuis project.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationProjectSections", fields: [organizationId], references: [id])
  parentId      String?
  parent        ProjectSection?  @relation("SectionHierarchy", fields: [parentId], references: [id])
  children      ProjectSection[] @relation("SectionHierarchy")
  type          SectionType
  nom           String
  description   String?
  responsableId String?
  responsable   User?            @relation("SectionResponsable", fields: [responsableId], references: [id])
  dateDebut     DateTime?
  dateFin       DateTime?
  statut        SectionStatus    @default(A_VENIR)
  ordre         Int              @default(0)
  tasks         Task[]
  documents     Document[]
  comments      SectionComment[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId])
  @@index([parentId])
  @@index([responsableId])
}

// Commentaire sur une section (Phase/Sous-phase/Lot) — miroir de TaskComment
// pour que ce niveau ait aussi un fil de discussion (cahier des charges §5).
model SectionComment {
  id        String         @id @default(cuid())
  sectionId String
  section   ProjectSection @relation(fields: [sectionId], references: [id])
  // Multi-tenant Phase 1 lot 7 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // section.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationSectionComments", fields: [organizationId], references: [id])
  authorId  String
  author    User           @relation("SectionCommentAuthor", fields: [authorId], references: [id])
  content   String
  createdAt DateTime       @default(now())

  @@index([sectionId])
}

// Tâche / Sous-tâche — un seul modèle auto-référencé (sous-tâche = parentTaskId non nul).
model Task {
  id                     String          @id @default(cuid())
  projectId              String
  project                Project         @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 3 (2026-08-20) — meme statut que Team/Project
  // (voir PlatformOrganization dans schema.prisma) : nullable, reversible,
  // denormalise depuis project.organizationId.
  organizationId         String?
  organization           PlatformOrganization? @relation("PlatformOrganizationTasks", fields: [organizationId], references: [id])
  sectionId              String?
  section                ProjectSection? @relation(fields: [sectionId], references: [id])
  parentTaskId           String?
  parentTask             Task?           @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subTasks               Task[]          @relation("TaskHierarchy")
  titre                  String
  description            String?
  priorite               TaskPriority    @default(MOYENNE)
  statut                 TaskStatus      @default(A_FAIRE)
  avancement             Int             @default(0)
  // Utilise par la vue Gantt (cahier des charges §7) ; distinct de createdAt
  // qui est la date de creation de l'enregistrement, pas la date de debut
  // prevue du travail.
  dateDebut              DateTime?
  echeance               DateTime?
  // Renseigné/vidé à la transition vers/depuis TERMINEE — sert au calcul du
  // respect des délais (cahier des charges §16), distinct de updatedAt qui
  // change à chaque modification.
  completedAt            DateTime?
  tempsEstimeHeures      Decimal?        @db.Decimal(6, 2)
  tempsReelHeures        Decimal?        @db.Decimal(6, 2)
  responsablePrincipalId String
  responsablePrincipal   User            @relation("TaskResponsablePrincipal", fields: [responsablePrincipalId], references: [id])
  // Mission deleguee a un prestataire/partenaire externe (cahier des
  // charges §XXI — "portail prestataire, avec missions et livrables").
  // Le contact CRM externe voit alors cette tache dans son portail ; ses
  // documents lies (deja existants) en tiennent lieu de livrables.
  externalContactId      String?
  externalContact        CrmContact?     @relation(fields: [externalContactId], references: [id])
  // Origines supplementaires (cahier des charges §IX — "la tache peut
  // provenir : ... d'un objectif ... d'un plan"). Optionnelles et
  // independantes du projet, purement traceabilite.
  objectiveId            String?
  objective              Objective?      @relation(fields: [objectiveId], references: [id])
  planId                 String?
  plan                   Plan?           @relation(fields: [planId], references: [id])
  // Traçabilité de l'origine "workflow" (cahier des charges §IX) : vrai
  // quand la tâche a été créée automatiquement par un circuit de validation
  // (ValidationWorkflow.creerTacheAlApprobation) ou une règle d'automatisation
  // (AutomationRule action CREATE_NEXT_TASK), plutôt que saisie manuellement.
  creeParWorkflow        Boolean         @default(false)
  createdById            String
  createdBy              User            @relation("TaskCreatedBy", fields: [createdById], references: [id])
  ordre                  Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  // Corbeille (V2.2 §37) — voir Project.deletedAt.
  deletedAt              DateTime?
  deletedById            String?
  deletedBy              User?           @relation("TaskDeletedBy", fields: [deletedById], references: [id])

  assignees           TaskAssignee[]
  checklistItems      ChecklistItem[]
  comments            TaskComment[]
  documents           Document[]
  dependsOn           TaskDependency[]    @relation("DependentTask")
  blocking            TaskDependency[]    @relation("PrerequisiteTask")
  meetingDecision     MeetingDecision?
  governanceDecision  GovernanceDecision?
  validationRun       TaskValidationRun?
  courrier            Courrier?
  adminRequest        AdminRequest?
  indicators          Indicator[]
  // Competences recherchees pour cette tache (V2.2 §9.2 — allocation
  // intelligente). Optionnel : le scoring de suggestAssignees se degrade
  // proprement (critere neutre) si aucune competence n'est renseignee.
  competencesRequises Competence[]        @relation("TaskCompetencesRequises")

  @@index([projectId])
  @@index([sectionId])
  @@index([parentTaskId])
  @@index([responsablePrincipalId])
  @@index([externalContactId])
  @@index([objectiveId])
  @@index([planId])
  @@index([statut])
  @@index([echeance])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  // Multi-tenant Phase 1 lot 7 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis task.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationTaskAssignees", fields: [organizationId], references: [id])

  @@id([taskId, userId])
}

model ChecklistItem {
  id            String    @id @default(cuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id])
  // Multi-tenant Phase 1 lot 7 (2026-08-20) — meme statut que TaskAssignee.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationChecklistItems", fields: [organizationId], references: [id])
  label         String
  isDone        Boolean   @default(false)
  ordre         Int       @default(0)
  // Responsable/échéance propres (cahier des charges §5 : "chaque niveau
  // peut avoir son responsable, ses échéances" — jusqu'à la checklist).
  responsableId String?
  responsable   User?     @relation("ChecklistItemResponsable", fields: [responsableId], references: [id])
  echeance      DateTime?
  createdAt     DateTime  @default(now())
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  // Multi-tenant Phase 1 lot 7 (2026-08-20) — meme statut que TaskAssignee.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationTaskComments", fields: [organizationId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions Reaction[]

  @@index([taskId])
}

model TaskDependency {
  id              String         @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  type            DependencyType @default(BLOQUE)
  task            Task           @relation("DependentTask", fields: [taskId], references: [id])
  dependsOnTask   Task           @relation("PrerequisiteTask", fields: [dependsOnTaskId], references: [id])
  createdAt       DateTime       @default(now())
  // Multi-tenant Phase 1 lot 7 (2026-08-20) — meme statut que TaskAssignee.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationTaskDependencies", fields: [organizationId], references: [id])

  @@unique([taskId, dependsOnTaskId])
}

// Circuit de validation configurable (cahier des charges §9, ex: Demande →
// Responsable → Directeur → DG). Défini une fois par un admin, réutilisé
// pour chaque tâche soumise à validation de ce type d'entité.
model ValidationWorkflow {
  id                      String               @id @default(cuid())
  // Multi-tenant Phase 1 lot 14 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationValidationWorkflows", fields: [organizationId], references: [id])
  nom                     String
  entityType              ValidationEntityType
  // Condition de selection du circuit (cahier des charges §VIII) — ne
  // s'applique qu'aux demandes administratives (entityType=ADMIN_REQUEST) :
  // adminRequestType nul = s'applique a tous les types ; montantMin nul =
  // aucun plancher. getActiveAdminRequestWorkflow() choisit le circuit
  // actif le plus specifique (voir src/lib/admin-request-workflow.ts).
  adminRequestType        AdminRequestType?
  montantMin              Decimal?             @db.Decimal(14, 2)
  isActive                Boolean              @default(true)
  // Action automatique a l'approbation complete (cahier des charges §VIII,
  // ex. "Mission creee" en fin de circuit) — cree une Task liee via
  // AdminRequest.taskId, dans autoTaskProjectId (requis si active).
  creerTacheAlApprobation Boolean              @default(false)
  autoTaskProjectId       String?
  autoTaskProject         Project?             @relation(fields: [autoTaskProjectId], references: [id])
  createdById             String
  createdBy               User                 @relation("ValidationWorkflowCreatedBy", fields: [createdById], references: [id])
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  steps            ValidationWorkflowStep[]
  runs             TaskValidationRun[]
  // Meme catalogue de circuits que les taches, mais instances separees
  // (voir AdminRequestValidationRun) : pas de relation polymorphe cote
  // Prisma, donc deux relations plutot qu'une seule generique.
  adminRequestRuns AdminRequestValidationRun[]

  @@index([entityType, isActive])
}

// Une étape du circuit, dans l'ordre `ordre` — l'approbateur est désigné par
// rôle (ex: RESPONSABLE puis DIRECTEUR puis DIRECTEUR_GENERAL).
model ValidationWorkflowStep {
  id            String             @id @default(cuid())
  // Multi-tenant Phase 1 lot 14 (2026-08-20) — meme statut que
  // ValidationWorkflow, denormalise depuis workflow.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationValidationWorkflowSteps", fields: [organizationId], references: [id])
  workflowId    String
  workflow      ValidationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  ordre         Int
  approverRole  RoleKey
  label         String?
  // Escalade (cahier des charges §VIII) — si l'etape n'est pas decidee
  // depuis plus de escaladeJours, le cron quotidien notifie en plus les
  // titulaires de escaladeRole (approvers normaux toujours notifies aussi).
  escaladeJours Int?
  escaladeRole  RoleKey?
  // Condition d'applicabilite de l'etape (cahier des charges §VIII,
  // "Condition") — ne s'applique qu'aux demandes administratives (montant
  // renseigne) ; null = pas de condition, l'etape s'applique toujours. Si le
  // montant de la demande ne satisfait pas la condition, l'etape est
  // ignoree automatiquement (voir decideAdminRequestCurrentStep) plutot que
  // bloquer le circuit sur une etape qui n'a pas lieu d'etre.
  montantMin    Decimal?           @db.Decimal(14, 2)
  montantMax    Decimal?           @db.Decimal(14, 2)

  approvals             TaskApproval[]
  adminRequestApprovals AdminRequestApproval[]

  @@unique([workflowId, ordre])
}

// Instance en cours (ou terminée) d'un circuit pour une tâche précise.
// `currentOrdre` pointe l'étape active ; historisée et notifiée à chaque
// transition (voir src/actions/task.actions.ts).
model TaskValidationRun {
  id            String              @id @default(cuid())
  // Multi-tenant Phase 1 lot 14 (2026-08-20) — meme statut que
  // ValidationWorkflow, denormalise depuis task.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationTaskValidationRuns", fields: [organizationId], references: [id])
  taskId        String              @unique
  task          Task                @relation(fields: [taskId], references: [id])
  workflowId    String
  workflow      ValidationWorkflow  @relation(fields: [workflowId], references: [id])
  statut        ValidationRunStatus @default(EN_COURS)
  currentOrdre  Int                 @default(1)
  submittedById String
  submittedBy   User                @relation("TaskValidationSubmittedBy", fields: [submittedById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  approvals TaskApproval[]

  @@index([taskId])
}

// Décision (approuvé/rejeté) prise à une étape précise d'une instance de
// circuit — une ligne par étape, créée EN_ATTENTE dès la soumission.
model TaskApproval {
  id          String                 @id @default(cuid())
  // Multi-tenant Phase 1 lot 14 (2026-08-20) — meme statut que
  // TaskValidationRun, denormalise depuis run.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationTaskApprovals", fields: [organizationId], references: [id])
  runId       String
  run         TaskValidationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId      String
  step        ValidationWorkflowStep @relation(fields: [stepId], references: [id])
  statut      ValidationStepStatus   @default(EN_ATTENTE)
  approverId  String?
  approver    User?                  @relation("TaskApprovalApprover", fields: [approverId], references: [id])
  commentaire String?
  decidedAt   DateTime?
  createdAt   DateTime               @default(now())

  @@unique([runId, stepId])
  @@index([runId])
  @@index([approverId])
}

// Demande administrative generique (achat, mission, decaissement, materiel,
// autorisation, recrutement...) soumise immediatement au circuit de
// validation actif de type ADMIN_REQUEST des sa creation (pas d'etat
// brouillon, comme Leave). Les conges restent geres par Leave, pas ici.
model AdminRequest {
  id           String             @id @default(cuid())
  // Multi-tenant Phase 1 lot 14 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // demandeur.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationAdminRequests", fields: [organizationId], references: [id])
  type         AdminRequestType
  titre        String
  description  String?
  montant      Decimal?           @db.Decimal(14, 2)
  dateDebut    DateTime?
  dateFin      DateTime?
  demandeurId  String
  demandeur    User               @relation("AdminRequestDemandeur", fields: [demandeurId], references: [id])
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  statut       AdminRequestStatus @default(EN_ATTENTE)
  // Tache/mission generee automatiquement a l'approbation complete du
  // circuit (cahier des charges §VIII, ex. "Demande de mission -> ... ->
  // Mission creee") — voir ValidationWorkflow.creerTacheAlApprobation.
  // Meme pattern que Courrier.taskId : la tache est un rattachement
  // optionnel, pas une propriete intrinseque de la demande.
  taskId       String?            @unique
  task         Task?              @relation(fields: [taskId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  validationRun AdminRequestValidationRun?

  @@index([demandeurId])
  @@index([statut])
}

// Miroir exact de TaskValidationRun, pour AdminRequest.
model AdminRequestValidationRun {
  id             String              @id @default(cuid())
  // Multi-tenant Phase 1 lot 14 (2026-08-20) — meme statut que
  // AdminRequest, denormalise depuis adminRequest.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationAdminRequestValidationRuns", fields: [organizationId], references: [id])
  adminRequestId String              @unique
  adminRequest   AdminRequest        @relation(fields: [adminRequestId], references: [id])
  workflowId     String
  workflow       ValidationWorkflow  @relation(fields: [workflowId], references: [id])
  statut         ValidationRunStatus @default(EN_COURS)
  currentOrdre   Int                 @default(1)
  submittedById  String
  submittedBy    User                @relation("AdminRequestValidationSubmittedBy", fields: [submittedById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  approvals AdminRequestApproval[]

  @@index([adminRequestId])
}

// Miroir exact de TaskApproval, pour AdminRequestValidationRun.
model AdminRequestApproval {
  id          String                    @id @default(cuid())
  // Multi-tenant Phase 1 lot 14 (2026-08-20) — meme statut que
  // AdminRequestValidationRun, denormalise depuis run.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationAdminRequestApprovals", fields: [organizationId], references: [id])
  runId       String
  run         AdminRequestValidationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId      String
  step        ValidationWorkflowStep    @relation(fields: [stepId], references: [id])
  statut      ValidationStepStatus      @default(EN_ATTENTE)
  approverId  String?
  approver    User?                     @relation("AdminRequestApprovalApprover", fields: [approverId], references: [id])
  commentaire String?
  decidedAt   DateTime?
  createdAt   DateTime                  @default(now())

  @@unique([runId, stepId])
  @@index([runId])
  @@index([approverId])
}

// Registre de courrier (cahier des charges §VII) — entrant/sortant/interne,
// avec cycle de vie a traiter -> en cours -> traite -> archive. Distinct des
// Demandes administratives (pas de circuit de validation ici, juste un
// registre suivi par un responsable) et de Document (le fichier joint est
// une simple URL, pas de versioning).
enum CourrierType {
  ENTRANT
  SORTANT
  INTERNE
}

enum CourrierStatus {
  A_TRAITER
  EN_COURS
  TRAITE
  ARCHIVE
}

model Courrier {
  id            String         @id @default(cuid())
  // Multi-tenant Phase 1 lot 14 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationCourriers", fields: [organizationId], references: [id])
  // Genere a la creation, format CRR-{annee}-{sequence}, ex. CRR-2026-0001.
  reference     String         @unique
  objet         String
  type          CourrierType
  statut        CourrierStatus @default(A_TRAITER)
  confidentiel  Boolean        @default(false)
  dateCourrier  DateTime
  // Texte libre : l'expediteur/destinataire n'est pas toujours un contact
  // CRM ou un utilisateur interne (ex. administration publique, particulier).
  expediteur    String?
  destinataire  String?
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  responsableId String?
  responsable   User?          @relation("CourrierResponsable", fields: [responsableId], references: [id])
  documentUrl   String?
  documentNom   String?
  notes         String?
  taskId        String?        @unique
  task          Task?          @relation(fields: [taskId], references: [id])
  createdById   String
  createdBy     User           @relation("CourrierCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([departmentId])
  @@index([responsableId])
  @@index([statut])
  @@index([type])
}

enum MeetingRecurrence {
  AUCUNE
  HEBDOMADAIRE
  MENSUELLE
}

model Meeting {
  id                    String            @id @default(cuid())
  projectId             String
  project               Project           @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 5 (2026-08-20) — meme statut que Task/
  // ProjectSection/Document : nullable, reversible, denormalise depuis
  // project.organizationId.
  organizationId        String?
  organization          PlatformOrganization? @relation("PlatformOrganizationMeetings", fields: [organizationId], references: [id])
  titre                 String
  dateHeure             DateTime
  lieu                  String?
  ordreDuJour           String?
  compteRendu           String?
  statut                MeetingStatus     @default(PLANIFIEE)
  // Reunions recurrentes (cahier des charges §XI) — recurrence renseignee
  // seulement sur la reunion "mere" ; les occurrences generees pointent
  // vers elle via recurrenceParentId, ce qui les regroupe en serie sans
  // avoir a parser une regle RRULE.
  recurrence            MeetingRecurrence @default(AUCUNE)
  recurrenceParentId    String?
  recurrenceParent      Meeting?          @relation("MeetingRecurrence", fields: [recurrenceParentId], references: [id])
  recurrenceOccurrences Meeting[]         @relation("MeetingRecurrence")
  createdById           String
  createdBy             User              @relation("MeetingCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  participants         MeetingParticipant[]
  decisions            MeetingDecision[]
  documents            Document[]
  externalParticipants MeetingExternalParticipant[]

  @@index([projectId])
  @@index([dateHeure])
  @@index([recurrenceParentId])
}

model MeetingParticipant {
  meetingId String
  userId    String
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
  // Multi-tenant Phase 1 lot 7 (2026-08-20) — meme statut que TaskAssignee,
  // denormalise depuis meeting.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationMeetingParticipants", fields: [organizationId], references: [id])

  @@id([meetingId, userId])
}

// Une décision/action peut donner naissance à une Task (cahier des charges
// §8 : « les actions décidées deviennent automatiquement des tâches »).
// Decision (cahier des charges §VI/§X) : issue d'une reunion (meetingId) OU
// prise directement au niveau projet sans reunion (projectId) — exactement
// l'un des deux est renseigne, verifie en application plutot qu'en
// contrainte DB (meme pattern que Reaction.taskCommentId/messageId).
enum DecisionStatus {
  EN_COURS
  TRAITEE
  ANNULEE
}

model MeetingDecision {
  id            String         @id @default(cuid())
  meetingId     String?
  meeting       Meeting?       @relation(fields: [meetingId], references: [id])
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 7 (2026-08-20) — meme statut que TaskAssignee,
  // denormalise depuis meeting.organizationId OU project.organizationId
  // (l'un des deux est toujours renseigne).
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationMeetingDecisions", fields: [organizationId], references: [id])
  description   String
  // Motif (cahier des charges §XI) — pourquoi cette decision, distinct de
  // la description de l'action elle-meme.
  motif         String?
  statut        DecisionStatus @default(EN_COURS)
  responsableId String?
  responsable   User?          @relation("MeetingDecisionResponsable", fields: [responsableId], references: [id])
  echeance      DateTime?
  taskId        String?        @unique
  task          Task?          @relation(fields: [taskId], references: [id])
  createdAt     DateTime       @default(now())

  @@index([meetingId])
  @@index([projectId])
}

// Dossier documentaire d'un projet — auto-référencé pour le classement en
// sous-dossiers (cahier des charges §10 : « classement par dossiers »).
model DocumentFolder {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 5 (2026-08-20) — meme statut que Meeting.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationDocumentFolders", fields: [organizationId], references: [id])
  parentId    String?
  parent      DocumentFolder?  @relation("DocumentFolderHierarchy", fields: [parentId], references: [id])
  children    DocumentFolder[] @relation("DocumentFolderHierarchy")
  nom         String
  createdById String
  createdBy   User             @relation("DocumentFolderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  documents Document[]

  @@index([projectId])
  @@index([parentId])
}

// Un document appartient toujours à un projet ; il peut en plus être lié à
// une tâche ou une réunion (cahier des charges §10 : « les documents
// peuvent être liés à des tâches ou à des réunions »). Le contrôle d'accès
// s'appuie sur les permissions document.* et l'appartenance au projet
// (ProjectMember), pas sur une liste d'accès par document.
// Type de document (cahier des charges §16) — permet de distinguer un
// contrat (suivi de signature) d'un simple fichier de travail.
enum DocumentType {
  CONTRAT
  RAPPORT
  FACTURE
  PROCES_VERBAL
  LIVRABLE
  MODELE
  AUTRE
}

// Statut de signature (cahier des charges §16), pertinent surtout pour les
// documents de type CONTRAT mais laisse disponible pour tout document.
enum DocumentSignatureStatus {
  NON_REQUISE
  EN_ATTENTE
  SIGNE
  REFUSE
}

// Validation client d'un livrable (cahier des charges §21) : un membre
// interne marque un document comme "a valider" une fois le livrable pret ;
// le partenaire/prestataire concerne (Task.externalContactId) le valide ou
// le rejette depuis le portail. Independant de statutSignature (signature de
// contrat) qui repond a un besoin different.
enum DocumentValidationStatus {
  NON_REQUISE
  EN_ATTENTE
  VALIDE
  REJETE
}

model Document {
  id                           String                   @id @default(cuid())
  projectId                    String
  project                      Project                  @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 4 (2026-08-20) — meme statut que Task/
  // ProjectSection : nullable, reversible, denormalise depuis
  // project.organizationId.
  organizationId               String?
  organization                 PlatformOrganization?    @relation("PlatformOrganizationDocuments", fields: [organizationId], references: [id])
  folderId                     String?
  folder                       DocumentFolder?          @relation(fields: [folderId], references: [id])
  sectionId                    String?
  section                      ProjectSection?          @relation(fields: [sectionId], references: [id])
  taskId                       String?
  task                         Task?                    @relation(fields: [taskId], references: [id])
  meetingId                    String?
  meeting                      Meeting?                 @relation(fields: [meetingId], references: [id])
  messageId                    String?
  message                      Message?                 @relation(fields: [messageId], references: [id])
  nom                          String
  description                  String?
  url                          String
  mimeType                     String?
  sizeBytes                    Int?
  type                         DocumentType             @default(AUTRE)
  statutSignature              DocumentSignatureStatus  @default(NON_REQUISE)
  dateSignature                DateTime?
  // Archivage (cahier des charges §17) : un document archive reste consultable
  // mais disparait des listes par defaut (voir estArchive dans les filtres).
  estArchive                   Boolean                  @default(false)
  dateArchivage                DateTime?
  archivedById                 String?
  archivedBy                   User?                    @relation("DocumentArchivedBy", fields: [archivedById], references: [id])
  validationExterne            DocumentValidationStatus @default(NON_REQUISE)
  dateValidationExterne        DateTime?
  commentaireValidationExterne String?
  // Isolation des portails externes (modules §16-20) : un document de projet
  // n'apparait dans /portail/projets/[id] QUE s'il est explicitement marque
  // partageable en plus d'appartenir a un projet autorise (ProjectStakeholder.
  // contactId) — sans ce flag, "isole des donnees internes" (exigence §19)
  // ne serait qu'une intention, pas une garantie.
  partageExterne               Boolean                  @default(false)
  // Un document depose depuis le portail externe (cahier des charges §21) a
  // uploadedByContactId renseigne et uploadedById null ; l'inverse pour un
  // depot interne classique — jamais les deux a la fois.
  uploadedById                 String?
  uploadedBy                   User?                    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedByContactId          String?
  uploadedByContact            CrmContact?              @relation("DocumentUploadedByContact", fields: [uploadedByContactId], references: [id])
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  // Corbeille (V2.2 §37) — distinct d'estArchive (archivage : le document
  // reste consultable) : deletedAt le retire de toutes les listes.
  deletedAt                    DateTime?
  deletedById                  String?
  deletedBy                    User?                    @relation("DocumentDeletedBy", fields: [deletedById], references: [id])

  versions     DocumentVersion[]
  accessGrants DocumentAccess[]

  @@index([projectId])
  @@index([folderId])
  @@index([sectionId])
  @@index([taskId])
  @@index([meetingId])
  @@index([messageId])
  @@index([type])
  @@index([estArchive])
}

// Controle d'acces par document (cahier des charges §10). Sans ligne pour un
// document : acces regi par les permissions document.* + appartenance au
// projet, comme avant (comportement par defaut inchange). Des qu'au moins
// une ligne existe, le document devient "prive" : seuls l'uploader et les
// utilisateurs listes ici peuvent le consulter, meme s'ils ont acces au
// projet.
model DocumentAccess {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Multi-tenant Phase 1 lot 7 (2026-08-20) — meme statut que TaskAssignee,
  // denormalise depuis document.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationDocumentAccesses", fields: [organizationId], references: [id])
  userId     String
  user       User     @relation("DocumentAccessGrantee", fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
}

// Data Governance (cahier des charges V3.0 §46) — classification/
// sensibilité/qualité/propriétaire d'une donnée, distincts de qui l'a
// créée (createdById/uploadedById, déjà présents sur chaque modèle) :
// un propriétaire de gouvernance peut être réassigné indépendamment de
// l'auteur d'origine. entityType/entityId reprend la convention ouverte de
// Dependency/EntityTag (pas de FK typée par type) ; seul "Document" a une
// UI de classification pour l'instant (/gouvernance-donnees), le modèle
// reste ouvert à d'autres types sans migration. Les autres facettes du
// cahier (accès, conservation, archivage, historique) réutilisent des
// mécanismes déjà en place (DocumentAccess/PermissionOverride,
// RetentionPolicy, Document.estArchive, AuditLog) plutôt que d'être
// dupliquées ici.
model DataClassification {
  id             String                  @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // classifiedBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationDataClassifications", fields: [organizationId], references: [id])
  entityType     String
  entityId       String
  niveau         DataClassificationLevel @default(INTERNE)
  sensibilite    DataSensitivity         @default(NORMALE)
  qualite        DataQualityNiveau       @default(NON_EVALUEE)
  proprietaireId String?
  proprietaire   User?                   @relation("DataClassificationProprietaire", fields: [proprietaireId], references: [id])
  notes          String?
  classifiedById String
  classifiedBy   User                    @relation("DataClassificationClassifiedBy", fields: [classifiedById], references: [id])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
}

enum DataClassificationLevel {
  PUBLIC
  INTERNE
  CONFIDENTIEL
  RESTREINT
}

enum DataSensitivity {
  NORMALE
  PERSONNELLE
  FINANCIERE
  STRATEGIQUE
}

enum DataQualityNiveau {
  NON_EVALUEE
  FAIBLE
  MOYENNE
  BONNE
  EXCELLENTE
}

// Historique des modifications (cahier des charges §10) : chaque nouvelle
// version crée une entrée ; `Document` reflète toujours la version courante.
model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  // Multi-tenant Phase 1 lot 7 (2026-08-20) — meme statut que
  // DocumentAccess.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationDocumentVersions", fields: [organizationId], references: [id])
  url         String
  mimeType    String?
  sizeBytes   Int?
  note        String?
  createdById String
  createdBy   User     @relation("DocumentVersionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([documentId])
}

// Base de connaissances (cahier des charges §13) — wiki d'entreprise,
// distinct des Document (fichiers uploadés, toujours rattachés a un projet) :
// un article est du contenu texte libre, rattache a l'organisation entiere
// via un arbre de categories (meme principe self-referential que
// DocumentFolder/Department), pas a un projet. Pas d'historique de versions
// separe (contrairement a DocumentVersion) : editer un article le modifie
// en place, updatedAt suffit pour un wiki interne.
enum KnowledgeArticleStatus {
  BROUILLON
  PUBLIE
}

// Compétences (cahier des charges §XII, "Évaluation individuelle :
// Compétences") — catalogue global géré en administration, assignation
// libre-service par collaborateur (comme un CV structuré).
enum CompetenceNiveau {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
  EXPERT
}

model Competence {
  id          String   @id @default(cuid())
  nom         String   @unique
  categorie   String?
  // Multi-tenant Phase 1 lot 8 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationCompetences", fields: [organizationId], references: [id])
  createdById String
  createdBy   User     @relation("CompetenceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  users          UserCompetence[]
  tasksRequiring Task[]           @relation("TaskCompetencesRequises")
}

model UserCompetence {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  // Multi-tenant Phase 1 lot 8 (2026-08-20) — meme statut que Competence.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationUserCompetences", fields: [organizationId], references: [id])
  competenceId String
  competence   Competence       @relation(fields: [competenceId], references: [id])
  niveau       CompetenceNiveau @default(DEBUTANT)
  notes        String?
  createdAt    DateTime         @default(now())

  @@unique([userId, competenceId])
  @@index([userId])
  @@index([competenceId])
}

model KnowledgeCategory {
  id          String              @id @default(cuid())
  nom         String
  parentId    String?
  parent      KnowledgeCategory?  @relation("KnowledgeCategoryHierarchy", fields: [parentId], references: [id])
  children    KnowledgeCategory[] @relation("KnowledgeCategoryHierarchy")
  // Multi-tenant Phase 1 lot 8 (2026-08-20) — meme statut que Competence.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationKnowledgeCategories", fields: [organizationId], references: [id])
  createdById String
  createdBy   User                @relation("KnowledgeCategoryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())

  articles KnowledgeArticle[]

  @@index([parentId])
}

model KnowledgeArticle {
  id          String                 @id @default(cuid())
  titre       String
  content     String
  tags        String?
  statut      KnowledgeArticleStatus @default(BROUILLON)
  // Multi-tenant Phase 1 lot 8 (2026-08-20) — meme statut que Competence.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationKnowledgeArticles", fields: [organizationId], references: [id])
  categoryId  String?
  category    KnowledgeCategory?     @relation(fields: [categoryId], references: [id])
  authorId    String
  author      User                   @relation("KnowledgeArticleAuthor", fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([statut])
}

// Congé (cahier des charges §12 : le calendrier consolide tâches, réunions,
// congés et événements). Validation simple par une personne habilitée
// (leave.manage), pas un circuit de validation à plusieurs étapes.
model Leave {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation("LeaveRequestedBy", fields: [userId], references: [id])
  // Multi-tenant Phase 1 lot 8 (2026-08-20) — meme statut que Competence,
  // denormalise depuis user.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationLeaves", fields: [organizationId], references: [id])
  type        LeaveType   @default(CONGE_PAYE)
  dateDebut   DateTime
  dateFin     DateTime
  motif       String?
  statut      LeaveStatus @default(EN_ATTENTE)
  decidedById String?
  decidedBy   User?       @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([dateDebut])
  @@index([dateFin])
}

// Événement générique du calendrier consolidé — sans projet, c'est un
// événement d'entreprise ; avec projet, visible dans le calendrier de ce
// projet uniquement.
model Event {
  id          String    @id @default(cuid())
  titre       String
  description String?
  dateDebut   DateTime
  dateFin     DateTime?
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 8 (2026-08-20) — meme statut que Competence,
  // denormalise depuis createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationEvents", fields: [organizationId], references: [id])
  createdById String
  createdBy   User      @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([projectId])
  @@index([dateDebut])
}

// Objectif (cahier des charges §13) — annuel/trimestriel/mensuel/hebdomadaire,
// individuel/équipe (= membres d'un Projet)/département. Exactement un des
// champs userId/projectId/departmentId est renseigné selon `scope`.
model Objective {
  id           String          @id @default(cuid())
  titre        String
  description  String?
  periode      ObjectivePeriod
  scope        ObjectiveScope
  dateDebut    DateTime
  dateFin      DateTime
  statut       ObjectiveStatus @default(EN_COURS)
  userId       String?
  user         User?           @relation("ObjectiveUser", fields: [userId], references: [id])
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id])
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id])
  // Multi-tenant Phase 1 lot 8 (2026-08-20) — meme statut que Competence,
  // denormalise depuis createdBy.organizationId (createdById toujours
  // renseigne, contrairement a user/project/department).
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationObjectives", fields: [organizationId], references: [id])
  // Portee PROGRAMME (cahier des charges §V, menu "Objectifs" du programme).
  programmeId  String?
  programme    Programme?      @relation(fields: [programmeId], references: [id])
  planId       String?
  plan         Plan?           @relation(fields: [planId], references: [id])
  // Rattachement a un axe strategique (cahier des charges §III), optionnel
  // quelle que soit la portee de l'objectif.
  axisId       String?
  axis         StrategicAxis?  @relation(fields: [axisId], references: [id])
  // Cahier des charges §III — cascade d'objectifs (entreprise -> direction
  // -> equipe -> individuel), independante du rattachement a un Plan.
  parentId     String?
  parent       Objective?      @relation("ObjectiveHierarchy", fields: [parentId], references: [id])
  children     Objective[]     @relation("ObjectiveHierarchy")
  createdById  String
  createdBy    User            @relation("ObjectiveCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  indicators Indicator[]
  tasks      Task[]

  @@index([userId])
  @@index([projectId])
  @@index([departmentId])
  @@index([programmeId])
  @@index([planId])
  @@index([axisId])
  @@index([parentId])
  @@index([periode])
}

// Indicateur mesurable relié à un objectif (cahier des charges §13).
// KPI (cahier des charges §VI/§IX) : rattache a un Objective, un Project ou
// une Task — exactement un des trois, verifie en application (meme pattern
// que MeetingDecision ci-dessus). Le rattachement Objective reste le cas
// historique (Resultats cles/OKR) ; Project/Task etendent le meme modele
// plutot que d'en dupliquer un.
model Indicator {
  id             String     @id @default(cuid())
  objectiveId    String?
  objective      Objective? @relation(fields: [objectiveId], references: [id])
  projectId      String?
  project        Project?   @relation(fields: [projectId], references: [id])
  taskId         String?
  task           Task?      @relation(fields: [taskId], references: [id])
  // Multi-tenant Phase 1 lot 8 (2026-08-20) — meme statut que Competence,
  // denormalise depuis l'un des trois parents (Objective/Project/Task).
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationIndicators", fields: [organizationId], references: [id])
  nom            String
  unite          String?
  valeurCible    Decimal    @db.Decimal(12, 2)
  valeurActuelle Decimal    @default(0) @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([objectiveId])
  @@index([projectId])
  @@index([taskId])
}

// Cahier des charges §14 — évaluation de performance périodique. Flux à
// deux parties (évaluateur note, évalué accuse réception) sur le modèle de
// Leave plutôt que le circuit ValidationWorkflow multi-étapes : pas besoin
// d'une chaîne de rôles configurable ici, juste un aller-retour.
enum EvaluationPeriode {
  ANNUELLE
  SEMESTRIELLE
  TRIMESTRIELLE
}

enum EvaluationStatus {
  BROUILLON
  SOUMISE
  ACCUSE_RECEPTION
}

// Cahier des charges §XII — "Types d'evaluation". PERIODIQUE n'est pas un
// type distinct ici : c'est deja porte par Evaluation.periode, applicable a
// n'importe lequel des 4 types ci-dessous.
enum EvaluationType {
  MANAGER
  AUTO
  PAIRS_360
  PROJET
}

model Evaluation {
  id                    String            @id @default(cuid())
  type                  EvaluationType    @default(MANAGER)
  periode               EvaluationPeriode
  dateDebut             DateTime
  dateFin               DateTime
  evalueId              String
  evalue                User              @relation("EvaluationEvalue", fields: [evalueId], references: [id])
  evaluateurId          String
  evaluateur            User              @relation("EvaluationEvaluateur", fields: [evaluateurId], references: [id])
  // Departement de l'evalue au moment de la creation — fige pour les
  // rapports meme si l'evalue change ensuite de departement.
  departmentId          String?
  department            Department?       @relation(fields: [departmentId], references: [id])
  // Renseigne seulement pour type=PROJET (cahier des charges §XII).
  projectId             String?
  project               Project?          @relation(fields: [projectId], references: [id])
  // Multi-tenant Phase 1 lot 8 (2026-08-20) — meme statut que Competence,
  // denormalise depuis createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationEvaluations", fields: [organizationId], references: [id])
  pointsForts           String?
  axesAmelioration      String?
  commentaireEvaluateur String?
  commentaireEvalue     String?
  scoreGlobal           Decimal?          @db.Decimal(3, 2)
  statut                EvaluationStatus  @default(BROUILLON)
  dateSoumission        DateTime?
  dateAccuseReception   DateTime?
  createdById           String
  createdBy             User              @relation("EvaluationCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  criteres EvaluationCritere[]

  @@index([evalueId])
  @@index([evaluateurId])
  @@index([departmentId])
  @@index([projectId])
  @@index([dateDebut])
}

// Critère individuel noté (ex : "Qualité du travail", "Ponctualité") —
// même principe qu'Indicator, mais pour une évaluation.
model EvaluationCritere {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  // Multi-tenant Phase 1 lot 8 (2026-08-20) — meme statut que Competence,
  // denormalise depuis evaluation.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationEvaluationCriteres", fields: [organizationId], references: [id])
  libelle      String
  note         Decimal    @db.Decimal(3, 2)
  commentaire  String?
  createdAt    DateTime   @default(now())

  @@index([evaluationId])
}

// Messagerie interne (cahier des charges §11). Une conversation à deux
// participants est une messagerie directe ; `isGroup` + `nom` distinguent
// une discussion de groupe.
// Une conversation privee n'a pas de projet (projectId null). Une conversation
// de projet (cahier des charges §10 : « fil de discussion par projet ») a
// projectId renseigne et unique : un seul canal par projet, dont les
// participants sont synchronises sur l'equipe projet (voir
// src/lib/project-conversation.ts) plutot que geres manuellement.
model Conversation {
  id          String   @id @default(cuid())
  nom         String?
  isGroup     Boolean  @default(false)
  projectId   String?  @unique
  project     Project? @relation(fields: [projectId], references: [id])
  // Conversation d'equipe (cahier des charges §X), meme principe que
  // projectId ci-dessus : un seul canal par equipe, participants
  // synchronises sur TeamMember plutot que geres manuellement.
  teamId      String?  @unique
  team        Team?    @relation(fields: [teamId], references: [id])
  createdById String
  createdBy   User     @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  // Multi-tenant Phase 1 lot 9 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationConversations", fields: [organizationId], references: [id])
  createdAt   DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  // Multi-tenant Phase 1 lot 9 (2026-08-20) — meme statut que Conversation,
  // denormalise depuis conversation.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationConversationParticipants", fields: [organizationId], references: [id])
  joinedAt       DateTime     @default(now())
  // Horodatage de la derniere ouverture de la conversation par ce
  // participant (mis a jour par markConversationRead). Les messages des
  // autres posterieurs a cette date sont "non lus". Null tant que la
  // conversation n'a jamais ete ouverte.
  lastReadAt     DateTime?

  @@id([conversationId, userId])
}

// Piece jointe (cahier des charges §11 : « partage de fichiers ») portee
// directement par le message plutot que par un Document : une conversation
// n'a pas de projectId (contrairement a Document.projectId, obligatoire),
// donc un fichier partage en messagerie ne peut pas legitimement devenir un
// Document du modele documentaire de projet.
model Message {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id])
  authorId            String
  author              User         @relation("MessageAuthor", fields: [authorId], references: [id])
  // Multi-tenant Phase 1 lot 9 (2026-08-20) — meme statut que Conversation,
  // denormalise depuis conversation.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationMessages", fields: [organizationId], references: [id])
  content             String
  attachmentUrl       String?
  attachmentNom       String?
  attachmentMimeType  String?
  attachmentSizeBytes Int?
  createdAt           DateTime     @default(now())
  // Suppression douce, par l'auteur uniquement : le contenu/pièce jointe
  // sont effacés mais la ligne reste (garde la place dans le fil, comme
  // WhatsApp/Slack — "Message supprimé" plutôt qu'un trou silencieux).
  deletedAt           DateTime?

  reactions Reaction[]
  documents Document[]

  @@index([conversationId])
}

// Réaction à un message ou à un commentaire de tâche — exactement un des
// deux champs taskCommentId/messageId est renseigné. Une contrainte unique
// par cible empêche la même personne de poser deux fois le même emoji (les
// valeurs NULL de l'autre cible ne bloquent rien, Postgres les traite comme
// distinctes).
model Reaction {
  id            String       @id @default(cuid())
  emoji         String
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  // Multi-tenant Phase 1 lot 9 (2026-08-20) — meme statut que Conversation,
  // denormalise depuis user.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationReactions", fields: [organizationId], references: [id])
  taskCommentId String?
  taskComment   TaskComment? @relation(fields: [taskCommentId], references: [id])
  messageId     String?
  message       Message?     @relation(fields: [messageId], references: [id])
  createdAt     DateTime     @default(now())

  @@unique([userId, taskCommentId, emoji])
  @@unique([userId, messageId, emoji])
}

// Notifications in-app (cahier des charges §18). `entityType`/`entityId`
// permettent de dédupliquer les notifications générées à la volée
// (échéance proche / retard) plutôt que de les régénérer à chaque visite.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  // Multi-tenant Phase 1 lot 9 (2026-08-20) — meme statut que Conversation,
  // denormalise depuis user.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationNotifications", fields: [organizationId], references: [id])
  type       NotificationType
  titre      String
  lien       String?
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  // V2.2 §39 — canaux vises (INTERNE toujours present) et niveau abstrait,
  // derives automatiquement de `type` dans createNotification() plutot que
  // sur chaque site d'appel (voir NOTIFICATION_NIVEAU_BY_TYPE dans notify.ts).
  channels   NotificationChannel[] @default([INTERNE])
  niveau     NotificationNiveau     @default(INFORMATION)

  @@unique([userId, type, entityType, entityId])
  @@index([userId, isRead])
}

// Règle d'automatisation (cahier des charges §15 ; étendue V2.2 §7-§8).
// projectId optionnel depuis V2.2 : une règle peut être globale (déclencheurs
// CRM/organisationnels non liés à un projet) ou scopée à un projet. Les
// champs de configuration sont tous optionnels au niveau du modèle ; seuls
// ceux pertinents pour `action` sont utilisés à l'exécution (voir
// src/lib/automation.ts). playbookId/ordre : si renseignés, la règle est une
// étape ordonnée d'un OrchestrationPlaybook (V2.2 §8) plutôt qu'une règle
// indépendante.
model AutomationRule {
  id        String               @id @default(cuid())
  // Multi-tenant Phase 1 lot 15 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationAutomationRules", fields: [organizationId], references: [id])
  projectId String?
  project   Project?             @relation(fields: [projectId], references: [id])
  nom       String
  trigger   AutomationTrigger
  action    AutomationActionType
  isActive  Boolean              @default(true)
  // Gouvernance IA (cahier des charges V2.2 §42) — palier par regle ;
  // AUTOMATISATION preserve le comportement historique (toutes les regles
  // existantes s'y retrouvent par defaut, aucune regression). Les types
  // d'action sensibles (§43) forcent VALIDATION independamment de ce champ
  // (voir SENSITIVE_ACTION_TYPES dans src/lib/automation.ts).
  niveauIA  AiGovernanceNiveau   @default(AUTOMATISATION)

  playbookId String?
  playbook   OrchestrationPlaybook? @relation(fields: [playbookId], references: [id])
  ordre      Int                    @default(0)

  // Config action CREATE_NEXT_TASK
  nextTaskTitre         String?
  nextTaskResponsableId String?
  nextTaskResponsable   User?   @relation("AutomationNextTaskResponsable", fields: [nextTaskResponsableId], references: [id])
  nextTaskDelaiJours    Int?

  // Config action SEND_REMINDER / déclencheur DEADLINE_APPROACHING
  reminderDelaiJours Int?

  // Config action ASSIGN_USER (V2.2 §7.3)
  assignUserId String?
  assignUser   User?   @relation("AutomationAssignUser", fields: [assignUserId], references: [id])

  // Config action CHANGE_STATUS (V2.2 §7.3) — valeur brute de l'enum cible
  // (TaskStatus ou ProjectStatus selon entityType du contexte déclencheur).
  changeStatusValue String?

  // Config action CREATE_MEETING (V2.2 §7.3 / §8)
  meetingTitre      String?
  meetingDelaiJours Int?

  // Config action CREATE_ADMIN_REQUEST (V2.2 §7.3)
  adminRequestType  AdminRequestType?
  adminRequestTitre String?

  // Config action CREATE_RISK (V2.2 §7.3)
  riskTitre       String?
  riskProbabilite RiskProbability?
  riskImpact      RiskImpact?

  // Config action GENERATE_REPORT (V2.2 §7.3) — valeur de ReportType
  // (src/lib/reports.ts), pas d'enum Prisma dédié pour rester aligné sur la
  // liste déjà définie côté application.
  reportType String?

  // Config action TRIGGER_WORKFLOW (V2.2 §7.3) — rechaîne une autre règle.
  targetRuleId String?
  targetRule   AutomationRule?  @relation("AutomationTriggerWorkflow", fields: [targetRuleId], references: [id])
  triggeredBy  AutomationRule[] @relation("AutomationTriggerWorkflow")

  // Config action CREATE_DEADLINE (comble V2.2 §7.3) — crée un Event
  // marquant une échéance plutôt qu'un nouveau modèle dédié.
  deadlineTitre      String?
  deadlineDelaiJours Int?

  // Config action ORCHESTRATE_NOUVEAU_CONTRAT (V3.0 §15) — departement et
  // responsable du projet/equipe crees ; "contrat important" se configure
  // via une Condition existante (contract.montant GREATER_THAN seuil),
  // aucun champ dedie necessaire pour ce seuil.
  orchestrationDepartmentId String?
  orchestrationDepartment   Department? @relation(fields: [orchestrationDepartmentId], references: [id])
  orchestrationResponsableId String?
  orchestrationResponsable   User?      @relation("AutomationOrchestrationResponsable", fields: [orchestrationResponsableId], references: [id])

  // Branche ELSE (comble V2.2 §7.2 — IF/ELSE/AND/OR) : si les conditions de
  // cette règle échouent, exécute elseRule (une règle complète, avec sa
  // propre action) au lieu de ne rien faire. Réutilise entièrement le
  // moteur existant plutôt que de dupliquer tous les champs de config pour
  // une "action sinon" séparée.
  elseRuleId String?
  elseRule   AutomationRule?  @relation("AutomationElseRule", fields: [elseRuleId], references: [id])
  isElseFor  AutomationRule[] @relation("AutomationElseRule")

  createdById String
  createdBy   User     @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conditions AutomationCondition[]
  executions AutomationExecution[]
  pendingAiActions PendingAiAction[]

  @@index([projectId])
  @@index([trigger])
  @@index([playbookId])
}

// Journal d'exécution — rend le moteur transparent (pas une boîte noire) :
// on peut voir quand une règle s'est déclenchée et ce qu'elle a produit.
model AutomationExecution {
  id         String         @id @default(cuid())
  // Multi-tenant Phase 1 lot 15 (2026-08-20) — meme statut que
  // AutomationRule, denormalise depuis rule.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationAutomationExecutions", fields: [organizationId], references: [id])
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id])
  entityType String
  entityId   String
  resultat   String
  executedAt DateTime       @default(now())

  @@index([ruleId])
}

// ===================== V2.2 §41-43 — Matrice de decision, gouvernance IA, human-in-the-loop =====================
enum AiGovernanceNiveau {
  SUGGESTION
  VALIDATION
  AUTOMATISATION
}

enum PendingAiActionStatut {
  EN_ATTENTE
  APPROUVE
  REJETE
}

// Action IA en attente de validation humaine (cahier §42 niveau 2, §43
// "human in the loop"). Cree par runIntegrationEventRules/run*Rules quand
// la regle declenchee est en niveau VALIDATION (ou que son AutomationActionType
// est dans SENSITIVE_ACTION_TYPES, voir automation.ts) au lieu d'executer
// l'action immediatement. `conditionData` est re-serialise tel quel pour que
// l'approbation puisse rejouer exactement le meme contexte via performAction().
model PendingAiAction {
  id            String                @id @default(cuid())
  // Multi-tenant Phase 1 lot 15 (2026-08-20) — meme statut que
  // AutomationRule, denormalise depuis rule.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationPendingAiActions", fields: [organizationId], references: [id])
  ruleId        String
  rule          AutomationRule        @relation(fields: [ruleId], references: [id])
  entityType    String
  entityId      String
  label         String
  projectId     String?
  conditionData Json?
  statut        PendingAiActionStatut @default(EN_ATTENTE)
  createdAt     DateTime              @default(now())
  decidedById   String?
  decidedBy     User?                 @relation("PendingAiActionDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  motifRejet    String?

  @@index([ruleId])
  @@index([statut])
}

// ===================== V3.0 §13 — Organizational Health Score =====================
enum HealthScoreDimension {
  PERFORMANCE
  CHARGE
  RISQUES
  PROJETS
  PROCESSUS
  QUALITE
  GOUVERNANCE
  // Aucune donnee de depart/turnover dans ce MVP (pas de modele RH dedie) —
  // ligne presente pour rester configurable/explicable (cahier : "lorsque
  // les donnees pertinentes sont disponibles"), isActive=false par defaut,
  // exclue du calcul de la moyenne ponderee tant qu'aucune donnee n'existe.
  TURNOVER
  SATISFACTION
  ECHEANCES
}

// Poids configurable par dimension (cahier §13 : "le score doit etre
// configurable et explicable") — chaque score de dimension est toujours
// calcule dynamiquement a partir des donnees existantes, jamais stocke ici
// (voir src/lib/health-score.ts) ; seul le poids relatif est persiste.
model HealthScoreWeight {
  dimension HealthScoreDimension @id
  poids     Int                  @default(10)
  isActive  Boolean              @default(true)
  updatedAt DateTime             @updatedAt
}

// ===================== V3.0 §19 — Digital Transformation Management =====================
enum TransformationType {
  DIGITALE
  RESTRUCTURATION
  EXPANSION_GEOGRAPHIQUE
  CHANGEMENT_ORGANISATIONNEL
  FUSION
  ACQUISITION
  LANCEMENT_ACTIVITE
}

// Cycle du cahier des charges §19 : Diagnostic -> Plan -> Transformation ->
// Adoption -> Mesure -> Amelioration. Avancee manuellement (pas de logique
// d'auto-avancement) — une transformation majeure se valide etape par etape.
enum TransformationPhase {
  DIAGNOSTIC
  PLAN
  TRANSFORMATION
  ADOPTION
  MESURE
  AMELIORATION
}

enum TransformationStatut {
  EN_COURS
  TERMINEE
  ANNULEE
}

// L'analyse d'impact (V3.0 §20 — Change Impact Analysis) est calculee a la
// volee a partir des Dependency enregistrees sur cette transformation (voir
// src/lib/change-impact.ts), pas stockee ici, meme principe que l'analyse
// d'impact §6.
model Transformation {
  id            String                @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationTransformations", fields: [organizationId], references: [id])
  nom           String
  type          TransformationType
  description   String?
  phase         TransformationPhase   @default(DIAGNOSTIC)
  statut        TransformationStatut  @default(EN_COURS)
  departmentId  String?
  department    Department?           @relation(fields: [departmentId], references: [id])
  responsableId String
  responsable   User                  @relation("TransformationResponsable", fields: [responsableId], references: [id])
  dateDebut     DateTime?
  dateFin       DateTime?
  createdById   String
  createdBy     User                  @relation("TransformationCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([departmentId])
  @@index([statut])
}

// ===================== V3.0 §17-18 — AI Memory Organisationnelle / Organizational Memory =====================
// §18 cree l'archive ; §17 est la capacite de recherche dessus
// (src/lib/organizational-memory.ts) — pas un modele separe, une simple
// requete deterministe (comme les autres agents IA, cf. AiAgentInsight).
// Deux facons d'alimenter l'archive : automatiquement a des transitions de
// cycle de vie deja modelisees (archivage d'un Processus, cloture d'une
// Transformation — voir processus.actions.ts/transformation.actions.ts), ou
// manuellement via createMemoryEntry pour les succes/echecs/experiences qui
// n'ont pas d'entite dediee. entityType/entityId (comme AiAgentInsight) relie
// une entree a l'entite d'origine sans dupliquer ses donnees.
enum OrganizationalMemoryType {
  DECISION
  PROJET
  SUCCES
  ECHEC
  INCIDENT
  RECOMMANDATION
  PROCEDURE
  EXPERIENCE
  TRANSFORMATION
}

model OrganizationalMemoryEntry {
  id          String                    @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationOrganizationalMemoryEntries", fields: [organizationId], references: [id])
  type        OrganizationalMemoryType
  titre       String
  contenu     String
  entityType  String?
  entityId    String?
  createdById String
  createdBy   User                      @relation("OrganizationalMemoryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime                  @default(now())

  @@index([type])
  @@index([entityType, entityId])
}

enum NiveauQualitatif {
  FAIBLE
  MOYEN
  ELEVE
}

// Matrice de decision (cahier §41) — un manager compare plusieurs options
// selon 7 criteres ; la recommandation (option la mieux notee) est calculee,
// jamais saisie manuellement, via computeDecisionRecommendation
// (src/lib/decision-matrix.ts). Cout/delai/ressources : plus bas = mieux ;
// ROI : plus haut = mieux ; risque/impact/faisabilite : echelle qualitative
// a 3 niveaux (impact = benefice attendu de l'option, pas un risque).
model DecisionMatrix {
  id          String   @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationDecisionMatrices", fields: [organizationId], references: [id])
  titre       String
  contexte    String?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  // Ponderation par critere (0-100, defaut egal) — permet a un manager de
  // prioriser p.ex. le risque sur le cout selon le contexte de la decision.
  poidsCout        Int @default(50)
  poidsDelai       Int @default(50)
  poidsRisque      Int @default(50)
  poidsImpact      Int @default(50)
  poidsRessources  Int @default(50)
  poidsRoi         Int @default(50)
  poidsFaisabilite Int @default(50)
  createdById String
  createdBy   User     @relation("DecisionMatrixCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options DecisionOption[]

  @@index([projectId])
}

model DecisionOption {
  id           String           @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que
  // DecisionMatrix, denormalise depuis matrix.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationDecisionOptions", fields: [organizationId], references: [id])
  matrixId     String
  matrix       DecisionMatrix   @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  nom          String
  description  String?
  cout         Decimal?         @db.Decimal(14, 2)
  delaiJours   Int?
  risque       NiveauQualitatif @default(MOYEN)
  impact       NiveauQualitatif @default(MOYEN)
  ressources   Decimal?         @db.Decimal(10, 2)
  roiPercent   Decimal?         @db.Decimal(6, 2)
  faisabilite  NiveauQualitatif @default(MOYEN)
  createdAt    DateTime         @default(now())

  @@index([matrixId])
}

// Générique — sert aussi d'historique des modifications de tâche/projet.
model AuditLog {
  id         String   @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // user.organizationId quand renseigne (certaines entrees sont generees
  // hors requete utilisateur, ex. automatisations serveur).
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationAuditLogs", fields: [organizationId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json?
  // Adresse IP de la requête à l'origine de l'action (cahier des charges
  // §18/§23 : journalisation complète). Absente pour les entrées générées
  // hors requête HTTP (ex. automatisations serveur).
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Connexion à un système externe (cahier des charges §21). `apiKey` est le
// secret partagé attendu sur les webhooks entrants (en-tête `x-api-key`) —
// masqué à l'affichage, jamais exposé après création. Aucun appel sortant
// réel n'est effectué dans ce MVP (pas d'identifiants tiers disponibles).
model Integration {
  id          String            @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationIntegrations", fields: [organizationId], references: [id])
  nom         String
  type        IntegrationType
  statut      IntegrationStatus @default(DECONNECTE)
  apiKey      String?
  webhookUrl  String?
  description String?
  lastSyncAt  DateTime?
  createdById String
  createdBy   User              @relation("IntegrationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  events IntegrationEvent[]
}

// Journal des webhooks entrants reçus pour une intégration.
model IntegrationEvent {
  id            String      @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que
  // Integration, denormalise depuis integration.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationIntegrationEvents", fields: [organizationId], references: [id])
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  eventType     String
  payload       Json
  receivedAt    DateTime    @default(now())

  @@index([integrationId])
}

// Préférences de widgets du tableau de bord (cahier des charges §16 :
// « les widgets sont configurables »). `widgets` est un tableau JSON de clés
// dans l'ordre d'affichage souhaité ; l'absence de ligne = tous les widgets,
// dans l'ordre par défaut (voir src/lib/dashboard-widgets.ts).
model DashboardWidgetPreference {
