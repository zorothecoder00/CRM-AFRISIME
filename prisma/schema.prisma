  updatedAt   DateTime           @updatedAt

  participants GovernanceMeetingParticipant[]
  decisions    GovernanceDecision[]
  documents    GovernanceMeetingDocument[]

  @@index([instanceId])
}

model GovernanceMeetingParticipant {
  meetingId String
  userId    String
  meeting   GovernanceMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User              @relation("GovernanceMeetingParticipantUser", fields: [userId], references: [id])
  // Multi-tenant Phase 1 lot 12 (2026-08-20) — meme statut que
