  deltaEffectifPercent    Decimal?     @db.Decimal(6, 2)
  deltaRessourcesPercent  Decimal?     @db.Decimal(6, 2)
  deltaProjetsPercent     Decimal?     @db.Decimal(6, 2)
  // Cas NOUVELLE_FILIALE : effectif/ressources/projets ajoutes en absolu.
