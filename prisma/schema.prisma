}

// Cahier des charges §15 — moteur générique déclencheur → action, sans
// développement. N'importe quel déclencheur peut être associé à n'importe
// quelle action (comme Zapier/IFTTT) ; seuls les champs de config
// pertinents pour l'action choisie sont utilisés à l'exécution.
enum AutomationTrigger {
  TASK_COMPLETED
  TASK_VALIDATION_REJECTED
  DEADLINE_APPROACHING
  PROJECT_COMPLETED
  // Ajoutes (cahier des charges §22) : declencheurs evalues par le cron
  // quotidien (src/app/api/cron/daily-checks/route.ts), pas a la visite.
  TASK_OVERDUE
  PROJECT_OVERDUE
  BUDGET_EXCEEDED
  RISK_CRITICAL
  // Ajoutes (V2.2 §7 — automatisation intelligente). Evenementiels, declenches
  // en ligne depuis le point de creation/changement concerne (voir les
  // appels run*Rules dans les actions serveur correspondantes) ; seul
  // INDICATOR_OFF_TARGET rejoint le groupe evalue par le cron quotidien.
  TASK_CREATED
  TASK_STATUS_CHANGED
  PROJECT_STATUS_CHANGED
  OPPORTUNITY_CREATED
  RISK_CREATED
  DECISION_CREATED
  MEETING_CREATED
  EVENT_CREATED
  INDICATOR_OFF_TARGET
  // Ajoute (comble V2.2 §7.1 — "nouveau contrat" necessitait un modele
  // Contract, absent jusqu'ici). Evenementiel, comme OPPORTUNITY_CREATED.
  CONTRACT_CREATED
  // Ajoute (V2.2 §35 — automatisation inter-systemes). Declenche depuis la
  // route webhook entrante (/api/webhooks/[integrationId]) des qu'un
  // IntegrationEvent est journalise, pas depuis le cron quotidien.
  INTEGRATION_EVENT_RECEIVED
}

enum AutomationActionType {
  CREATE_NEXT_TASK
  SEND_REMINDER
  NOTIFY_STAKEHOLDERS
  // Ajoutes (cahier des charges §22)
  ESCALATE_TO_MANAGER
  MARK_TASK_BLOCKED
  // Ajoutes (V2.2 §7 — automatisation intelligente)
  ASSIGN_USER
  // Journalise l'intention uniquement (voir AutomationExecution.resultat) :
  // aucun fournisseur d'email n'est cable dans ce MVP.
  SEND_EMAIL
  CHANGE_STATUS
  CREATE_MEETING
  CREATE_ADMIN_REQUEST
  CREATE_RISK
  GENERATE_REPORT
  REQUEST_VALIDATION
  TRIGGER_WORKFLOW
  // Ajoutes (V2.2 §8 — orchestration), utilisees par le playbook type
  // "Mise en route projet"
  VERIFY_RESOURCES
  VERIFY_RISKS
  OPEN_TRACKING_BOARD
  // Ajoute (comble V2.2 §7.3 — "créer échéance" n'avait pas d'action
  // dédiée, seulement l'échéance implicite de CREATE_NEXT_TASK). Crée un
  // Event de type échéance plutôt qu'un nouveau modèle dédié.
  CREATE_DEADLINE
  // Ajoute (V3.0 §15 — orchestration autonome de workflows). Action
  // composite unique (pas 10 AutomationRule chaînées : la cible du chaînage,
  // le projet, n'existe pas encore avant l'étape 1) qui exécute d'un coup
  // les 10 étapes de l'exemple du cahier (créer projet/équipe, identifier
  // compétences, planning, risque, KPI, réunion, notifier, documents, suivi)
  // — voir orchestrateNouveauContrat dans src/lib/automation.ts. Toujours
  // dans SENSITIVE_ACTION_TYPES : validation humaine obligatoire.
  ORCHESTRATE_NOUVEAU_CONTRAT
}

// Condition d'une regle d'automatisation (V2.2 §7.2 — IF/ELSE/AND/OR).
// Evaluation sequentielle gauche->droite dans l'ordre (pas de parenthesage) :
// voir evaluateConditions dans src/lib/automation-conditions.ts. `champ` est
// une cle du registre de champs disponibles par type d'entite declenchante
// (ex. "task.retardJours", "project.critique", "risk.criticite").
enum AutomationConditionOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  LESS_THAN
  CONTAINS
}

enum AutomationConditionConnector {
  ET
  OU
}

model AutomationCondition {
  id         String                       @id @default(cuid())
  // Multi-tenant Phase 1 lot 15 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // rule.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationAutomationConditions", fields: [organizationId], references: [id])
  ruleId     String
  rule       AutomationRule               @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  champ      String
  operateur  AutomationConditionOperator
  valeur     String
  // S'applique entre cette condition et la suivante (ordre croissant) ;
  // ignore pour la derniere condition de la regle.
  connecteur AutomationConditionConnector @default(ET)
  ordre      Int                          @default(0)

  @@index([ruleId])
}

// Regroupement nomme de plusieurs AutomationRule executees dans l'ordre pour
// un meme declencheur (V2.2 §8 — orchestration, ex. "Mise en route projet").
// Une regle sans playbookId continue de fonctionner de maniere independante
// comme avant ; une regle avec playbookId est une etape ordonnee du playbook.
model OrchestrationPlaybook {
  id          String            @id @default(cuid())
  // Multi-tenant Phase 1 lot 15 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationOrchestrationPlaybooks", fields: [organizationId], references: [id])
  nom         String
  description String?
  trigger     AutomationTrigger
  isActive    Boolean           @default(true)
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id])
  createdById String
  createdBy   User              @relation("OrchestrationPlaybookCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  steps AutomationRule[]

  @@index([trigger])
  @@index([projectId])
}

// Cahier des charges §21 — cadre générique de connexion à des systèmes
// externes (AfriGes, M365, WhatsApp...). Sans identifiants réels disponibles,
// ce MVP fournit l'enregistrement des connexions et un webhook entrant
// générique validé par clé partagée, mais n'appelle aucun service tiers.
//
// AFRIGES RESTE LE SYSTÈME OPÉRATIONNEL (cahier des charges V3.0 §55,
// règle fondamentale) — AfriGes est l'ERP opérationnel de l'organisation
// (ventes, achats, stock, comptabilité, crédit, opérations) ; AfriFlow/
// Work-Flow (CE projet) est le système d'exploitation ORGANISATIONNEL
// (stratégie, CRM, projets, collaboration, gouvernance, processus,
// intelligence, IA, simulation, performance) — les deux communiquent
// UNIQUEMENT via cette couche d'intégration (IntegrationType.AFRIGES ici,
// et SYSTEME_FINANCIER pour la vue "Finances" du Strategic Command Center,
// §35/§48), jamais par un accès direct à la base de données de l'autre
// système. Ce projet ne doit PAS développer de modules de vente/achat/
// stock/comptabilité — ce serait dupliquer AfriGes plutôt que s'y
// connecter. Rappel opérationnel : ce sont deux bases de données Neon
// distinctes (afriflow / afriges) — toujours vérifier laquelle est ciblée
// avant toute commande `prisma migrate` en production.
enum IntegrationType {
  AFRIGES
  M365
  GOOGLE_WORKSPACE
  SLACK
  VISIOCONFERENCE
  WHATSAPP
  // Ajoutes (V2.2 §34) — completent la liste du cahier des charges
  // (messagerie/calendrier deja couverts par SLACK/WHATSAPP/M365/
  // GOOGLE_WORKSPACE ci-dessus).
  EMAIL
  CALENDRIER
  STOCKAGE_DOCUMENTAIRE
  SYSTEME_FINANCIER
  OUTIL_MARKETING
  OUTIL_BI
  AUTRE
}

enum IntegrationStatus {
  CONNECTE
  DECONNECTE
  ERREUR
}

model User {
  id                         String      @id @default(cuid())
  name                       String
  email                      String      @unique
  passwordHash               String
  image                      String?
  roleId                     String
  role                       Role        @relation(fields: [roleId], references: [id])
  departmentId               String?
  department                 Department? @relation(fields: [departmentId], references: [id])
  // Multi-tenant (cahier des charges V3.0 §27, plan Phase 1 — voir
  // PlatformOrganization) — nullable et NON encore NOT NULL delibrement :
  // seuls User et Department portent ce champ pour l'instant (retrofit
  // reversible), pas encore de RLS (Phase 3), pas encore de backfill
  // obligatoire pour les ~148 autres modeles. Voir scripts/backfill-platform-organization.ts.
  organizationId             String?
  organization               PlatformOrganization? @relation("PlatformOrganizationUsers", fields: [organizationId], references: [id])
  // Poste / fonction (cahier des charges §I, "Postes / Fonctions") — libelle
  // libre historique, distinct du Role qui porte les permissions. posteId
  // est le rattachement structure (avec responsabilites) recommande pour
  // les nouveaux comptes ; les deux coexistent pour ne pas perdre les
  // libelles libres deja saisis.
  poste                      String?
  posteId                    String?
  posteRef                   Poste?      @relation(fields: [posteId], references: [id])
  // Site / agence de rattachement (cahier des charges §I).
  siteId                     String?
  site                       Site?       @relation(fields: [siteId], references: [id])
  // Rattachement hierarchique individuel (cahier des charges §I) — distinct
  // du departementId : deux collaborateurs du meme departement peuvent avoir
  // des managers differents, et un manager peut superviser des gens d'autres
  // departements (organisation matricielle).
  managerId                  String?
  manager                    User?       @relation("UserManager", fields: [managerId], references: [id])
  directReports              User[]      @relation("UserManager")
  isActive                   Boolean     @default(true)
  // Vue de la liste de tâches mémorisée (cahier des charges §7 : "chaque
  // utilisateur choisit sa vue") — null tant que l'utilisateur n'a jamais
  // changé de vue, /taches retombe alors sur "liste".
  defaultTaskView            String?
  // Base de calcul du taux d'occupation (cahier des charges §14).
  capaciteHebdomadaireHeures Decimal     @default(35) @db.Decimal(5, 2)
  // Authentification à deux facteurs (cahier des charges §22). mfaSecret
  // n'est renseigné qu'après confirmation (voir src/actions/security.actions.ts) ;
  // mfaBackupCodes stocke des codes de secours hashés (bcrypt), à usage unique.
  mfaEnabled                 Boolean     @default(false)
  mfaSecret                  String?
  mfaBackupCodes             Json?
  // V2.2 §39 — canaux preferes pour les notifications externes (EMAIL/SMS/
  // PUSH/MESSAGERIE_EXTERNE) ; createNotification() les croise avec les
  // canaux demandes par l'appelant avant de journaliser une tentative.
  notificationChannelsPreferred NotificationChannel[] @default([INTERNE])
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

