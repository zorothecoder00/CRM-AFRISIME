  // precedents : nullable, reversible, denormalise depuis
  // user.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationDashboardWidgetPreferences", fields: [organizationId], references: [id])
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  widgets   Json
  updatedAt DateTime @updatedAt
}

// ============================================================================
// EXTENSION v2.0 — "Extension du socle fonctionnel initial"
// ============================================================================
// Chaque nouveau module ci-dessous est un ajout pur : aucun modele existant
// n'est modifie ou supprime (hors deux relations inverses sur User/Project,
// necessaires cote Prisma pour les nouvelles relations nommees).

enum GovernanceInstanceType {
  CONSEIL_ADMINISTRATION
  COMITE_DIRECTION
  COMITE_PILOTAGE
  COMITE_TECHNIQUE
  COMMISSION
  GROUPE_TRAVAIL
  COMITE_AD_HOC
  AUTRE
}

enum GovernanceMemberStatus {
  ACTIF
  TERMINE
  SUSPENDU
}

enum GovernanceDecisionPriorite {
  BASSE
  MOYENNE
  HAUTE
  CRITIQUE
}

// §3 — Gouvernance. Distinct du Meeting/MeetingDecision existants (qui
// exigent tous deux un Project) : une instance de gouvernance (CA, comite
// de direction...) est un objet organisationnel, pas rattache a un projet —
// reutiliser Meeting aurait force un Project fictif pour chaque instance.
// Meme logique de decision -> tache auto-creee que MeetingDecision, en
// miroir (comme AdminRequestValidationRun est deja un miroir de
// TaskValidationRun dans ce schema).
model GovernanceInstance {
  id          String                 @id @default(cuid())
  // Multi-tenant Phase 1 lot 12 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationGovernanceInstances", fields: [organizationId], references: [id])
  nom         String
  type        GovernanceInstanceType @default(AUTRE)
  description String?
  estActive   Boolean                @default(true)
  createdById String
  createdBy   User                   @relation("GovernanceInstanceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  membres  GovernanceInstanceMember[]
  reunions GovernanceMeeting[]
}

model GovernanceInstanceMember {
  id         String                 @id @default(cuid())
  // Multi-tenant Phase 1 lot 12 (2026-08-20) — meme statut que
  // GovernanceInstance, denormalise depuis instance.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationGovernanceInstanceMembers", fields: [organizationId], references: [id])
  instanceId String
  instance   GovernanceInstance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  userId     String
  user       User                   @relation("GovernanceInstanceMemberUser", fields: [userId], references: [id])
  fonction   String?
  role       String?
  mandat     String?
  dateDebut  DateTime?
  dateFin    DateTime?
  statut     GovernanceMemberStatus @default(ACTIF)
  createdAt  DateTime               @default(now())

  @@index([instanceId])
  @@index([userId])
}

model GovernanceMeeting {
  id          String             @id @default(cuid())
  // Multi-tenant Phase 1 lot 12 (2026-08-20) — meme statut que
  // GovernanceInstance, denormalise depuis instance.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationGovernanceMeetings", fields: [organizationId], references: [id])
  instanceId  String
  instance    GovernanceInstance @relation(fields: [instanceId], references: [id])
  titre       String
  dateHeure   DateTime
  lieu        String?
  ordreDuJour String?
  compteRendu String?
