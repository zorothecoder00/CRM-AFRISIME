// ===================== V2.2 §22-25 — Multi-entites / Multi-pays / =====================
// ===================== Consolidation Groupe / Benchmarking =============================
// Entity est un arbre auto-reference au-dessus de Department, exactement le
// meme pattern (parentId/children, label calcule par profondeur — voir
// src/lib/entity-tree.ts) : Groupe/Societe/Filiale/Agence ne sont PAS des
// types stockes, seulement des libelles derives de la profondeur, pour
// rester coherent avec Direction/Departement/Service sur Department qui
// suivent deja cette convention. Un Department racine (parentId null) porte
// optionnellement un entityId ; les departements enfants heritent de
// l'entite de leur racine (pas de denormalisation, voir entity-scope.ts).
model Entity {
  id       String   @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que Poste/Site :
  // nullable, reversible, aucun proprietaire direct (racine de
  // configuration multi-entites) — rattache par le backfill.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationEntities", fields: [organizationId], references: [id])
  nom      String
  code     String   @unique
  parentId String?
  parent   Entity?  @relation("EntityHierarchy", fields: [parentId], references: [id])
  children Entity[] @relation("EntityHierarchy")

  // Champs de configuration multi-pays (cahier des charges §23) — donnees
  // affichees/heritees dans la hierarchie, sans reformattage dynamique des
  // montants ni traduction d'UI (hors perimetre de ce lot, voir le plan).
  pays             String?
  devise           String?
  fuseauHoraire    String?
  langue           String?
  reglementations  String?
  parametresLocaux String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments      Department[]
  holidays         Holiday[]
  crmOrganizations CrmOrganization[]
  crmContacts      CrmContact[]

  @@index([parentId])
}

// Jour ferie (cahier des charges §23) — rattache a une Entity (pays/societe),
// recurrenceAnnuelle=true signifie que le jour/mois se repete chaque annee
// (ex. fete nationale), false pour une date ponctuelle.
model Holiday {
  id                 String   @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationHolidays", fields: [organizationId], references: [id])
  entityId           String
  entity             Entity   @relation(fields: [entityId], references: [id])
  nom                String
  date               DateTime
  recurrenceAnnuelle Boolean  @default(true)
  createdById        String
  createdBy          User     @relation("HolidayCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime @default(now())

  @@index([entityId])
}

// ===================== V2.2 §26-30 — Digital twin, knowledge graph, recherche, command center, briefing =====================
// Tags (cahier §28 — "recherche universelle ... avec tags"). Modele reel
// (choix explicite de l'utilisateur plutot qu'un champ texte libre par
// entite) : un Tag nomme + couleur, rattache a n'importe quelle entite via
// EntityTag (meme convention polymorphe que Dependency/MetricSnapshot —
// entityType/entityId en String plutot qu'une FK typee par paire de
// modeles). N'affecte pas KnowledgeArticle.tags (champ texte libre deja en
// place et deja cherche dans globalSearch) : les deux mecanismes coexistent.
model Tag {
  id          String   @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationTags", fields: [organizationId], references: [id])
  nom         String   @unique
  couleur     String?
  createdById String
  createdBy   User     @relation("TagCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  entities EntityTag[]
}

model EntityTag {
  id         String   @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que Tag,
  // denormalise depuis tag.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationEntityTags", fields: [organizationId], references: [id])
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
}

// ===================== V2.2 §31-35 — Weekly review, rapports, marketplace, API, automatisation inter-systemes =====================
// Cle API (cahier §34 — "cles API" ; OAuth2 complet reste un gap documente,
// disproportionne par rapport au reste de l'app). Seul le hash est stocke
// (meme principe que User.password) ; keyPrefix (8 premiers caracteres en
// clair) sert uniquement a identifier visuellement une cle dans la liste
// admin sans jamais pouvoir reconstituer la cle complete. `permissions` est
// un sous-ensemble libre de PermissionKey (String[], pas de relation
// typee — une cle API peut avoir un perimetre plus etroit que n'importe
// quel role) verifie manuellement dans chaque route /api/v1/*.
model ApiKey {
  id          String    @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationApiKeys", fields: [organizationId], references: [id])
  nom         String
  keyPrefix   String
  keyHash     String
  permissions String[]
  createdById String
  createdBy   User      @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

enum AppCategory {
  RH
  JURIDIQUE
  ONG
  BTP
  CABINET_CONSEIL
  INCUBATEUR
  FORMATION
  GESTION_ASSOCIATIVE
  GESTION_PROGRAMMES
  GESTION_PROJETS_FINANCES
}

enum AppCatalogStatut {
  PLANIFIE
  BIENTOT
  DISPONIBLE
}

// Catalogue "Work-Flow Apps" (cahier §33 — "preparer une architecture
// permettant a terme d'ajouter des applications"). Registre reel, pas une
// page statique : chaque entree est admin-gerable (statut modifiable a
// mesure qu'une app avance de PLANIFIE a DISPONIBLE), mais aucune app
// n'est reellement installable dans cette version — le catalogue prepare
// l'architecture sans construire les apps elles-memes, conformement au
// perimetre explicite du cahier des charges.
model AppCatalogEntry {
  id          String            @id @default(cuid())
  nom         String            @unique
  categorie   AppCategory
  description String?
  statut      AppCatalogStatut  @default(PLANIFIE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// ===================== V2.2 §36-40 — Securite, gestion des donnees, dashboards, notifications 2.0, priorisation IA =====================
// Sessions/appareils (cahier §36 — "sessions" + "controle des appareils").
// L'app reste en JWT sans etat (pas de session DB NextAuth classique) : ce
// modele est un registre PARALLELE, peuple a la connexion (voir auth.ts,
// callback jwt) et verifie a chaque lecture de session (callback session) —
// une revocation admin met immediatement session.user.permissions a vide et
// force la redirection vers /login au prochain rendu de page (voir
// src/app/(app)/layout.tsx), sans abandonner la strategie JWT.
model UserSession {
  id          String    @id @default(cuid())
  // Multi-tenant Phase 1 lot 17 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // user.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationUserSessions", fields: [organizationId], references: [id])
  userId      String
  user        User      @relation("UserSessionOwner", fields: [userId], references: [id])
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("UserSessionRevokedBy", fields: [revokedById], references: [id])

  @@index([userId])
}

// Canaux et niveaux de notification (cahier §39 — "Notification 2.0").
// EMAIL/SMS/PUSH/MESSAGERIE_EXTERNE restent journalises sans envoi reel
// (aucun fournisseur configure — meme statut que l'IA/l'email deja
// documente comme bloque, voir memoire projet) : createNotification()
// consigne l'intention plutot que d'echouer silencieusement.
enum NotificationChannel {
  INTERNE
  EMAIL
  SMS
  PUSH
  MESSAGERIE_EXTERNE
}

enum NotificationNiveau {
  INFORMATION
  RAPPEL
  VALIDATION
  ALERTE
  URGENCE
  ESCALADE
}

// ===================== V2.2 §37 — Retention =====================
// Politique de retention (cahier des charges §37 — "retention"). Bornee aux
// donnees SANS risque de cascade FK (journaux/evenements/notifications) —
// purge automatique, contrairement a la corbeille (Project/Task/Document)
// qui reste une action manuelle explicite (voir le commentaire en tete de
// src/actions/trash.actions.ts : aucune relation en onDelete: Cascade,
// purger automatiquement echouerait ou detruirait un sous-arbre entier
// selon le cas). Une entree separee (retentionDays sur TRASH) sert
// uniquement de seuil de RAPPEL — jamais de suppression automatique.
enum RetentionDataType {
  AUDIT_LOG
  NOTIFICATION
  INTEGRATION_EVENT
  METRIC_SNAPSHOT
  TRASH
}

model RetentionPolicy {
  id            String            @id @default(cuid())
  dataType      RetentionDataType @unique
  retentionDays Int
  isActive      Boolean           @default(true)
  updatedById   String?
  updatedBy     User?             @relation("RetentionPolicyUpdatedBy", fields: [updatedById], references: [id])
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())
}
