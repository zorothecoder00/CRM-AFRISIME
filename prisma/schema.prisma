  programmesOwned                  Programme[]                    @relation("ProgrammeResponsable")
  programmesCreated                Programme[]                    @relation("ProgrammeCreatedBy")
  adminRequestsCreated             AdminRequest[]                 @relation("AdminRequestDemandeur")
  adminRequestValidationsSubmitted AdminRequestValidationRun[]    @relation("AdminRequestValidationSubmittedBy")
  adminRequestApprovalsDecided     AdminRequestApproval[]         @relation("AdminRequestApprovalApprover")
  plansOwned                       Plan[]                         @relation("PlanOwner")
  plansCreated                     Plan[]                         @relation("PlanCreatedBy")
  evaluationsRecues                Evaluation[]                   @relation("EvaluationEvalue")
  evaluationsMenees                Evaluation[]                   @relation("EvaluationEvaluateur")
  evaluationsCreees                Evaluation[]                   @relation("EvaluationCreatedBy")
  knowledgeCategoriesCreated       KnowledgeCategory[]            @relation("KnowledgeCategoryCreatedBy")
  knowledgeArticlesAuthored        KnowledgeArticle[]             @relation("KnowledgeArticleAuthor")
  portalAccountsInvited            PortalAccount[]                @relation("PortalAccountInvitedBy")
  courriersResponsable             Courrier[]                     @relation("CourrierResponsable")
  courriersCreated                 Courrier[]                     @relation("CourrierCreatedBy")
  // Extension V3.0 — Organizational Designer (§21) et Talent & Succession (§24)
  orgDesignDraftsCreated            OrgDesignDraft[]               @relation("OrgDesignDraftCreatedBy")
  platformOrganizationsCreated      PlatformOrganization[]         @relation("PlatformOrganizationCreatedBy")
  decisionOutcomesCreated           DecisionOutcome[]              @relation("DecisionOutcomeCreatedBy")
  decisionOutcomesEvaluated         DecisionOutcome[]              @relation("DecisionOutcomeEvaluatedBy")
  dataClassificationsOwned          DataClassification[]           @relation("DataClassificationProprietaire")
  dataClassificationsClassifiedBy   DataClassification[]           @relation("DataClassificationClassifiedBy")
  successionPlansCreated            SuccessionPlan[]               @relation("SuccessionPlanCreatedBy")
  successionPlanTitulaireFor        SuccessionPlan[]               @relation("SuccessionPlanTitulaire")
  successionCandidacies             SuccessionCandidate[]          @relation("SuccessionCandidateUser")

  @@index([departmentId])
  @@index([roleId])
}

// Reinitialisation de mot de passe (cf. /api/auth/forgot-password et
// /api/auth/reset-password). tokenHash stocke le hash SHA-256 du token
// envoye par email : seul le hash est persiste, jamais le token en clair.
model PasswordResetToken {
  id        String    @id @default(cuid())
  // Multi-tenant Phase 1 lot 17 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // user.organizationId. tokenHash reste unique globalement (hash aleatoire,
  // pas une cle catalogue) : aucune collision possible entre organisations.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationPasswordResetTokens", fields: [organizationId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Role {
  id          String           @id @default(cuid())
  key         RoleKey          @unique
  label       String
  description String?
  isSystem    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id       String           @id @default(cuid())
  key      String           @unique
  label    String
  category String
  roles    RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// Dérogation de permission scopée par département et/ou projet (cahier des
// charges §19 : droits définissables « par rôle, département, projet ou
// équipe » — équipe = membres d'un Projet, cf. ProjectMember). Consultée
// uniquement quand un scope est explicitement passé à
// hasPermission/requirePermission (src/lib/permissions.ts) ; les appels
// existants sans scope ne sont pas affectés.
model PermissionOverride {
  id            String           @id @default(cuid())
  // Multi-tenant Phase 1 lot 17 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // user.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationPermissionOverrides", fields: [organizationId], references: [id])
  userId        String
  user          User             @relation("PermissionOverrideTarget", fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String
  departmentId  String?
  department    Department?      @relation(fields: [departmentId], references: [id])
  projectId     String?
  project       Project?         @relation(fields: [projectId], references: [id])
  // Portée équipe (cahier des charges §19 : droits « par rôle, département,
  // projet ou équipe ») — distincte du scope projet, s'appuie sur une vraie
  // Team plutôt que sur l'approximation "équipe = membres d'un projet".
  teamId        String?
  team          Team?            @relation(fields: [teamId], references: [id])
  effect        PermissionEffect @default(GRANT)
  createdById   String
  createdBy     User             @relation("PermissionOverrideCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  @@index([userId, permissionKey])
  @@index([departmentId])
  @@index([projectId])
  @@index([teamId])
}

model Department {
  id                  String               @id @default(cuid())
  name                String
  code                String               @unique
  parentId            String?
  parent              Department?          @relation("DeptHierarchy", fields: [parentId], references: [id])
  children            Department[]         @relation("DeptHierarchy")
  // Rattachement multi-entites (cahier des charges V2.2 §22) — uniquement
  // significatif sur un departement racine (parentId null) : un departement
  // enfant herite de l'entite de sa racine (voir getDepartmentEntityId dans
  // src/lib/entity-scope.ts), pas de denormalisation sur chaque noeud.
  entityId            String?
  entity              Entity?              @relation(fields: [entityId], references: [id])
  // Multi-tenant (V3.0 §27, plan Phase 1) — meme statut que User.organizationId
  // ci-dessus : nullable, reversible, pas de RLS. `code` reste @unique
  // globalement pour l'instant (une seule organisation existe reellement) ;
  // passage en unicite composite (organizationId, code) planifie en Phase 4,
  // pas fait ici.
  organizationId      String?
  organization        PlatformOrganization? @relation("PlatformOrganizationDepartments", fields: [organizationId], references: [id])
  users               User[]
  projects            Project[]
  objectives          Objective[]
  permissionOverrides PermissionOverride[]
  adminRequests       AdminRequest[]
  plans               Plan[]
  evaluations         Evaluation[]
  courriers           Courrier[]
  postes              Poste[]
  sites               Site[]
  teams               Team[]
  scenarios           Scenario[]
  orchestrationRules  AutomationRule[]
  transformations     Transformation[]
  orgDesignDrafts     OrgDesignDraft[]
  createdAt           DateTime             @default(now())

  @@index([entityId])
}

// Équipe (cahier des charges §I "Structures... Équipes" et niveau 5 du
// pilotage §XXIII) : regroupement de travail au sein d'un département,
// distinct de la hierarchie Direction/Departement/Service (qui est la
// profondeur de l'arbre Department) — une équipe est un groupe transverse
// ou informel, pas un niveau organisationnel supplementaire.
model Team {
  id           String     @id @default(cuid())
  nom          String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  // Multi-tenant Phase 1 lot 2 (2026-08-20) — meme statut que User/Department
  // (voir PlatformOrganization dans schema.prisma) : nullable, reversible,
  // denormalise plutot que resolu par jointure sur department.organizationId
  // (coherence avec le pattern deja en place, pas de contrainte DB qui
  // garantisse la synchronisation entre les deux — a surveiller si Team
  // change de departement).
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationTeams", fields: [organizationId], references: [id])
  leaderId     String?
  leader       User?      @relation("TeamLeader", fields: [leaderId], references: [id])
  createdById  String
  createdBy    User       @relation("TeamCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())

  members             TeamMember[]
  conversation        Conversation?
  permissionOverrides PermissionOverride[]

  @@index([departmentId])
}

model TeamMember {
  id       String   @id @default(cuid())
  // Multi-tenant Phase 1 lot 17 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis team.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationTeamMembers", fields: [organizationId], references: [id])
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
}

// Organizational Designer (cahier des charges V3.0 §21) — concevoir
// virtuellement une organisation (ex. "Direction Afrique de l'Ouest -> Togo
// -> Bénin -> Côte d'Ivoire" puis équipes/responsables/compétences/projets/
// processus) et la simuler avant tout déploiement réel. `structure` porte
// l'arbre brouillon complet en JSON (pas de tables Department/Team tant que
// non déployé) ; `simulationResume` mémorise le dernier résultat de
// simulateOrgDesign (src/lib/org-designer.ts). Le déploiement crée les vrais
// Department/Team/Project/Processus et relie deployedDepartmentId à la
// racine créée — un brouillon déployé n'est plus modifiable (voir
// deployOrgDesign).
model OrgDesignDraft {
  id                    String          @id @default(cuid())
  // Multi-tenant Phase 1 lot 16 (2026-08-20) — meme statut que les lots
  // precedents : nullable, reversible, denormalise depuis
  // createdBy.organizationId.
  organizationId String?
  organization   PlatformOrganization? @relation("PlatformOrganizationOrgDesignDrafts", fields: [organizationId], references: [id])
  nom                   String
  description           String?
  structure             Json
  statut                OrgDesignStatut @default(BROUILLON)
  simulationResume      Json?
  deployedDepartmentId  String?
  deployedDepartment    Department?     @relation(fields: [deployedDepartmentId], references: [id])
  createdById           String
  createdBy             User            @relation("OrgDesignDraftCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime        @default(now())
  simulatedAt           DateTime?
  deployedAt            DateTime?

  @@index([deployedDepartmentId])
}

enum OrgDesignStatut {
  BROUILLON
  SIMULE
  DEPLOYE
}

// Profil de l'organisation (cahier des charges §I "Profil de l'organisation"
// et §III "Vision / Mission / Valeurs") — ligne unique (id fixe "org-profile"),
// pas de vraie table multi-tenant : ce logiciel pilote une seule organisation.
model OrganizationProfile {
  id          String   @id @default("org-profile")
  nom         String   @default("Mon organisation")
  logoUrl     String?
  description String?
  vision      String?
  mission     String?
  valeurs     String?
  siteWeb     String?
  // Devise d'affichage des montants (cahier des charges V3.0 §3, objectif
  // "préparer la plateforme à fonctionner à l'échelle internationale") —
  // remplace le "FCFA" jusque-là codé en dur dans ~20 fichiers (voir
  // src/lib/currency.ts). Code libre (pas un enum fermé) : les devises
  // qu'une organisation manipule varient trop pour être figées en base,
  // même principe que CrmContact.segment.
  devise      String   @default("FCFA")
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// Taux de change (revue applicative du 2026-08-19, point faible "pas de
// moteur de conversion de change") — agréger des entités en devises
// différentes (§23 v2.2, multi-pays) sans convertir juxtaposait jusqu'ici
// des nombres bruts sous une étiquette unique, trompeur. Aucune clé API de
// taux de change en direct disponible dans cette instance (même contrainte
// que l'email/l'IA) : taux maintenus manuellement par un administrateur,
// comme ferait une équipe finance sans flux temps réel. Non orienté (une
// seule ligne par paire from->to) ; l'inverse est calculé à la volée
// (1/taux) par convertMontant() plutôt que dupliqué.
model ExchangeRate {
  id          String   @id @default(cuid())
  fromDevise  String
  toDevise    String
  taux        Decimal  @db.Decimal(18, 6)
  updatedById String
  updatedBy   User     @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([fromDevise, toDevise])
}

// Multi-Organization Platform (cahier des charges V3.0 §27) — "La V3 doit
// préparer Work-Flow à accueillir plusieurs organisations totalement
// indépendantes." Ce modèle est la couche fondation/registre (au-dessus
// d'OrganizationProfile, qui reste le profil de L'UNIQUE organisation
// pilotée par cette instance) : chaque ligne représente un futur tenant de
// la plateforme, avec son branding et son abonnement.
//
// Retrofit Phase 1 (2026-08-20, plan détaillé en Artifact "Isolation
// multi-tenant réelle pour AfriFlow") : organizationId nullable ajouté
