  incidents                                                              Incident[]                      @relation("PlatformOrganizationIncidents")
  changeRequests                                                            ChangeRequest[]                 @relation("PlatformOrganizationChangeRequests")
  validationWorkflows       ValidationWorkflow[]          @relation("PlatformOrganizationValidationWorkflows")
